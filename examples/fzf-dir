#!/usr/bin/env bash
#
# fzf-dir: prints a directory, chosen with fzf.
#
# An example of the only thing `tsm via` asks for: a program that prints a
# directory on stdout. Nothing in it is specific to tsm -- run it on its own
# and it prints a path; run `tsm via fzf-dir` and that path becomes a session.
#
#   ln -s "$PWD/examples/fzf-dir" ~/.local/bin/fzf-dir
#   tsm via fzf-dir
#
# It lists every directory under $HOME, at any depth, skipping hidden ones and
# everything inside them. To list something else, copy this file and change
# the find -- there is no configuration, because a program this short is
# easier to rewrite than to configure.
#
# Printing nothing and exiting 0 is how it declines to answer -- what happens
# when you press escape. Anything that is not the path goes to stderr.

selected=$(find "$HOME" -name ".*" -prune -o -type d -print \
  | fzf --cycle --prompt "Directory > ")

# Backing out is not a failure: say nothing and succeed.
[ -n "$selected" ] || exit 0

printf '%s\n' "$selected"
