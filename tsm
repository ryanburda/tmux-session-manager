#!/bin/bash

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tsm"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/tsm"
LOG_DIR="$STATE_DIR/logs"
RECORD_DIR="$STATE_DIR/sessions"
mkdir -p "$CONFIG_DIR" "$LOG_DIR"

# The internal verbs the tmux hooks call back on. Each is also the string
# `tsm init` greps for to recognise a hook it installed before.
HOOK_CREATED=_session_created
HOOK_CLOSED=_session_closed

usage() {
  cat <<'EOF'
Tmux Session Manager

Usage:
  tsm                                  # Show help message
  
  tsm at <path> [-c] [-p]              # Start or switch to session at a directory
    -c, --no-config                    # Ignore any configuration claiming that path
    -p, --prompt-name                  # Prompt for the session name instead of using the default
  
  tsm match [path]                     # Configurations claiming a path (defaults to the current directory)
  tsm logs [session]                   # Browse configured session logs
  
  tsm init                             # Install the tmux hooks tsm works through (put this in tmux.conf)

See https://github.com/ryanburda/tmux-session-manager for more documentation
EOF
}

####################
# helper functions #
####################
notify() {
  # Show a message: tmux display-message inside tmux, stderr otherwise.
  # stderr because several callers run inside a command substitution whose
  # stdout is their return value.
  local msg="$1"
  if [ -n "$TMUX" ]; then
    tmux display-message "$msg"
  else
    echo "$msg" >&2
  fi
}

switch_or_attach() {
  # Switch to a session if inside tmux, attach otherwise. Takes a tmux target
  # as-is, so callers pass `=name` for a name and `$id` for a session id; an
  # id is what survives the rename the session-created hook may be about to
  # make.
  local target="$1"
  if [ -n "$TMUX" ]; then
    tmux switch-client -t "$target"
  else
    tmux attach-session -t "$target"
  fi
}

self_path() {
  # Absolute path to this program. `tsm init` bakes it into the tmux hook:
  # the server's PATH is whatever it inherited when it started, which need
  # not hold the directory tsm was installed in.
  local self="$0"
  case "$self" in
    */*) ;;
    *) self=$(command -v -- "$self") || return 1 ;;
  esac

  printf '%s/%s\n' "$(cd "$(dirname "$self")" && pwd -P)" "$(basename "$self")"
}

session_record() {
  # Path of a session's cleanup record: the file whose existence says a
  # configuration built this session and is owed its `kill` when it closes.
  # It holds the directory the session was started at, which the hook cannot
  # read off the session itself -- tmux has freed @tsm_path and the session
  # environment by the time session-closed fires.
  #
  # Keyed by session id under the server's pid: ids restart at $0 with every
  # tmux server, so an id alone would be read back by an unrelated session of
  # a later one.
  #
  # Args:
  #   $1: pid: the tmux server's pid, #{pid}
  #   $2: id: the session id, #{session_id}, leading `$` and all
  printf '%s/%s/%s\n' "$RECORD_DIR" "$1" "${2#\$}"
}

session_paths() {
  # Emit "<session name>\t<path>" for every running session. The path is the
  # @tsm_path recorded at creation; #{session_path} is the fallback for
  # sessions tsm did not create (it drifts as the first pane cds around,
  # which is why @tsm_path exists).
  tmux list-sessions -F $'#{session_name}\t#{@tsm_path}\t#{session_path}' 2>/dev/null \
    | while IFS=$'\t' read -r name recorded fallback; do
        printf '%s\t%s\n' "$name" "${recorded:-$fallback}"
      done
}

session_for_path() {
  # Echo the running session started at $1, or nothing with a non-zero status.
  # Compared in the shell: tmux's filter parser reads `,` and `}` in a path.
  local want="$1" name path
  while IFS=$'\t' read -r name path; do
    [ "$path" = "$want" ] || continue
    printf '%s\n' "$name"
    return 0
  done < <(session_paths)
  return 1
}

sanitize_session_name() {
  # Replace every character outside [A-Za-z0-9_-/] with _. `/` survives for
  # repo/worktree names; `.` and `:` must not, being tmux target separators.
  # Takes a name, not a path: callers take the basename themselves.
  printf '%s' "$1" | tr -c 'a-zA-Z0-9_/-' '_'
}

client_size() {
  # Print "WIDTH HEIGHT" for the client that will attach, or nothing. tmux
  # creates detached sessions at 80x24, so percentage splits made before the
  # client attaches drift once the real size arrives; sizing up front avoids
  # that.
  local width height

  width=$(tmux display-message -p '#{client_width}' 2>/dev/null)
  height=$(tmux display-message -p '#{client_height}' 2>/dev/null)

  # Outside tmux, fall back to the terminal tsm was invoked from.
  if [ -z "$width" ] || [ -z "$height" ]; then
    read -r height width < <({ stty size < /dev/tty; } 2>/dev/null)
  fi

  case "$width$height" in
    *[!0-9]* | '') return 1 ;;
  esac

  # A pty with no size set answers `0 0`, which tmux refuses.
  [ "$width" -gt 0 ] && [ "$height" -gt 0 ] || return 1

  echo "$width $height"
}

expand_short_flags() {
  # Split clustered short flags (-cp -> -c -p) into EXPANDED_ARGS so the
  # subcommand parsers see one flag per argument. Everything else passes
  # through untouched.
  EXPANDED_ARGS=()
  local arg i
  for arg in "$@"; do
    case "$arg" in
      -[!-]*)
        for (( i = 1; i < ${#arg}; i++ )); do
          EXPANDED_ARGS+=("-${arg:i:1}")
        done
        ;;
      *) EXPANDED_ARGS+=("$arg") ;;
    esac
  done
}

default_session_name() {
  # Derive a session name for a directory: repo/worktree for a linked
  # worktree, the sanitized basename otherwise. Two worktrees whose paths end
  # in the same segment derive the same name; that is caught later as a name
  # collision, since a session is identified by its path.
  #
  # Args:
  #   $1: path: directory to derive the session name from
  local path="$1"

  local git_dir
  git_dir=$(git -C "$path" rev-parse --absolute-git-dir 2>/dev/null)

  # A linked worktree's git dir is <common dir>/worktrees/<name> and holds a
  # gitdir file. Both are tested: inside a subdirectory of an ordinary repo,
  # rev-parse also answers absolutely.
  if [ -n "$git_dir" ] && [ -f "$git_dir/gitdir" ] &&
    [ "$(basename "$(dirname "$git_dir")")" = "worktrees" ]; then
    local repo_dir
    repo_dir=$(dirname "$(dirname "$git_dir")")
    local repo_leaf
    repo_leaf=$(basename "$repo_dir")

    # Step over conventional bare-repo wrappers: worktrees of
    # ~/code/api/.bare belong to `api`, not `.bare`.
    local repo_name
    if [ "$repo_leaf" = ".bare" ] || [ "$repo_leaf" = ".git" ]; then
      repo_name=$(basename "$(dirname "$repo_dir")")
    else
      repo_name="$repo_leaf"
    fi

    # Sanitized separately, so the joining `/` is the only one: a worktree
    # directory named v1.2 would otherwise put a `.` in the name.
    echo "$(sanitize_session_name "$repo_name")/$(sanitize_session_name "$(basename "$path")")"
  else
    sanitize_session_name "$(basename "$path")"
  fi
}

config_files() {
  # Paths of the configuration files under $CONFIG_DIR, one per line.
  # A configuration is an executable program; tsm runs it with a verb and
  # reads its answer.
  #
  # -L: configurations are commonly symlinks. -perm -u+x: -executable is
  # GNU-only. LC_ALL=C sort: tie-breaking must not depend on the locale.
  [ -d "$CONFIG_DIR" ] || return

  find -L "$CONFIG_DIR" -type f -perm -u+x 2>/dev/null | LC_ALL=C sort
}

config_name_for_file() {
  # Echo the configuration name for a file: its path under $CONFIG_DIR minus
  # any final extension, so `work`, `work.sh` and `work.fish` are all `work`.
  # A leading dot is not an extension: `.work.fish` is `.work`.
  #
  # Args:
  #   $1: file: path to a configuration file under $CONFIG_DIR
  local rel base dir="" dot=""
  rel="${1#"$CONFIG_DIR/"}"

  base="${rel##*/}"
  [ "$base" = "$rel" ] || dir="${rel%/*}/"

  case "$base" in .*) dot="."; base="${base#.}" ;; esac
  case "$base" in *.*) base="${base%.*}" ;; esac

  printf '%s%s%s\n' "$dir" "$dot" "$base"
}

run_config() {
  # Run a configuration with a verb: pattern, name, start or kill. The
  # contract is argv in, stdout and exit status out; tsm never looks inside
  # the file. A verb the program does not handle must exit 0. Only `pattern`
  # and `name` treat stdout as an answer; for `start` and `kill` it is the
  # session log, and callers redirect it there.
  #
  # set -m gives background jobs their own process group; the subshell keeps
  # a configuration that exits from taking tsm with it.
  #
  # Args:
  #   $1: file: path to the configuration
  #   $2: verb: one of pattern, name, start, kill
  #   $@: any further arguments the verb takes
  local file="$1" verb="$2"
  shift 2
  ( set -m; exec "$file" "$verb" "$@" )
}

rank_configs_for_root() {
  # Emit "<score>\t<file>" for every configuration whose pattern claims the
  # directory, best first; nothing if none does.
  #
  # The score is the length of the pattern, longest first: a proxy for
  # specificity measured on the pattern rather than the matched text, so a
  # catch-all `.*` always sorts last. Ties break on LC_ALL=C file path order.
  #
  # grep -Eq rather than [[ =~ ]] so a pattern means the same thing whatever
  # language printed it. A configuration that fails, prints nothing, or
  # prints an invalid regex simply does not match.
  #
  # Args:
  #   $1: path: the resolved directory a session would be rooted at
  local path="$1"

  local file pattern
  while IFS= read -r file; do
    pattern=$(
      export SESSION=""
      unset ROOT
      run_config "$file" pattern 2>/dev/null
    ) || continue

    [ -n "$pattern" ] || continue

    if printf '%s' "$path" | grep -Eq -- "$pattern" 2>/dev/null; then
      printf '%s\t%s\n' "${#pattern}" "$file"
    fi
  done < <(config_files) | LC_ALL=C sort -t$'\t' -k1,1nr -k2,2
}

matching_config_for_root() {
  # Echo the configuration claiming the directory (the top of the ranking),
  # or nothing with a non-zero status.
  #
  # Args:
  #   $1: path: the resolved directory a session would be rooted at
  local path="$1"

  local score file
  while IFS=$'\t' read -r score file; do
    printf '%s\n' "$file"
    return 0
  done < <(rank_configs_for_root "$path")

  return 1
}

config_session_name() {
  # Echo the session name configuration $1 gives directory $2, or nothing
  # with a non-zero status when it has no opinion. The directory arrives as
  # both the verb's argument and ROOT; SESSION is unset, being the thing
  # computed. Only the first line is read, whitespace-trimmed. Failing or
  # printing nothing is not an error: the default naming takes over. What is
  # printed is sanitized rather than refused, since names come from things
  # the configuration does not control (a branch, a directory).
  #
  # Args:
  #   $1: file: path to the configuration
  #   $2: path: the resolved directory the configuration matched
  local file="$1" path="$2" name

  name=$(
    export ROOT="$path"
    unset SESSION
    run_config "$file" name "$path" 2>/dev/null \
      | head -n 1 \
      | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
  ) || return 1

  [ -n "$name" ] || return 1

  sanitize_session_name "$name"
}

session_name_prompt() {
  # Prompt for a session name, offering $2 as the default. Echoes the name.
  #
  # Args:
  #   $1: path: the directory the session will be created at
  #   $2: session_name: the name to offer as the default
  local path="$1"
  local session_name="$2"

  printf "%s\n" "$(tput setaf 8)$path$(tput sgr0)" >&2
  while true; do
    local prompt="Enter session name"
    if ! tmux has-session -t "=$session_name" 2>/dev/null; then
      prompt="$prompt [$(tput setaf 4)${session_name}$(tput sgr0)]"
    fi
    # A read that cannot be answered ends this rather than looping: under
    # tmux's run-shell there is no terminal, and an unanswerable prompt in a
    # loop is a hang.
    if ! read -rp "$prompt: " user_input; then
      printf "\n" >&2
      notify "Error: no terminal to read a session name from"
      return 1
    fi

    local candidate="${user_input:-$session_name}"

    # `.` and `:` are tmux target separators; a name holding either could be
    # created but never targeted again. Rejected rather than rewritten: a
    # typed name is not tsm's to change. `/` is fine (repo/worktree).
    case "$candidate" in
      *[:.]*)
        printf "$(tput setaf 1)Session names cannot contain ':' or '.'$(tput sgr0)\n" >&2
        continue
        ;;
    esac

    session_name="$candidate"
    if ! tmux has-session -t "=$session_name" 2>/dev/null; then
      break
    fi
    printf "$(tput setaf 1)Session '%s' already exists.$(tput sgr0)\n" "$session_name" >&2
  done
  echo "$session_name"
}

#################
# api functions #
#################
install_hook() {
  # Point one global tmux hook at one of tsm's internal verbs. Appended, so
  # anyone else's hooks on it survive; any hook a previous `tsm init` left on
  # it is dropped first, so re-sourcing tmux.conf does not stack duplicates.
  #
  # Args:
  #   $1: hook: the tmux hook name
  #   $2: verb: the tsm verb it calls back on
  #   $3: self: absolute path to this program
  local hook="$1" verb="$2" self="$3"

  # Unsetting an array element leaves the others at their own indexes, so the
  # indexes collected here stay valid as they are removed.
  local index
  while IFS= read -r index; do
    tmux set-hook -gu "$hook[$index]"
  done < <(tmux show-hooks -g 2>/dev/null \
    | sed -n "s/^$hook\\[\\([0-9]\\{1,\\}\\)\\].*$verb.*/\\1/p")

  tmux set-hook -ga "$hook" \
    "run-shell \"'$self' $verb '#{hook_session}' '#{pid}' '#{hook_session_name}'\""
}

hook_installed() {
  # Whether `tsm init` has run on this server. Everything a configuration
  # does now happens in a hook, so a server without them is a tsm that
  # quietly does nothing.
  tmux show-hooks -g 2>/dev/null | grep -q -- "$HOOK_CREATED"
}

init_hook() {
  # Install the two tmux hooks tsm works through. Meant for tmux.conf, where
  # it runs once per server:
  #
  #   run-shell "tsm init"
  #
  # session-created applies a configuration to a session tmux has just made;
  # session-closed runs that configuration's `kill` when it goes away.
  #
  # Both are global. A session's own options are already freed when
  # session-closed fires, so a hook set on the session never runs at all.
  local self
  if ! self=$(self_path); then
    notify "Error: could not resolve the path to tsm"
    exit 1
  fi

  install_hook session-created "$HOOK_CREATED" "$self" || exit 1
  install_hook session-closed "$HOOK_CLOSED" "$self" || exit 1

  # A tmux server that is killed outright closes no sessions and so fires no
  # hooks, leaving its records behind. Reap the ones whose server is gone.
  # Another live server's records are left alone: several may be running.
  local dir pid
  for dir in "$RECORD_DIR"/*/; do
    [ -d "$dir" ] || continue
    pid=$(basename "$dir")
    case "$pid" in
      *[!0-9]*) continue ;;
    esac
    kill -0 "$pid" 2>/dev/null || rm -rf "$dir"
  done
}

session_created() {
  # The session-created hook, called back by tmux for every session it makes,
  # however it was made. This is where a configuration is applied: tsm names
  # the session, marks it, builds it and records it, all after the fact.
  #
  # Nothing happens unless a configuration claims the directory the session
  # was created at, so a plain `tmux new-session` anywhere else behaves
  # exactly as it always did.
  #
  # Args:
  #   $1: id: the new session's id, #{hook_session}
  #   $2: pid: the tmux server's pid, #{pid}
  #   $3: name: the name tmux gave it, #{hook_session_name}
  local id="$1" pid="$2" name="$3"

  # The opt-out, and the equivalent of `tsm at -c`. It travels in the session
  # environment because a hook runs under the tmux server and never sees the
  # environment of whoever asked for the session:
  #
  #   tmux new-session -e TSM_NO_CONFIG=1 -c <dir>
  tmux show-environment -t "$id" TSM_NO_CONFIG > /dev/null 2>&1 && exit 0

  # Where the session was created, which is #{session_path} before anything
  # has had the chance to cd away from it.
  local path
  path=$(tmux display-message -p -t "$id" '#{session_path}' 2>/dev/null)
  [ -n "$path" ] || exit 0

  local matching_file
  matching_file=$(matching_config_for_root "$path") || exit 0

  # One session per configured directory. A second session created at a
  # claimed path would collide on the name and build the layout a second
  # time, so the client that asked for it is sent to the session already
  # there instead. Only configured paths are deduplicated; two sessions at an
  # unclaimed directory are nobody's business but tmux's.
  # Matched on @tsm_path alone, and never against the new session itself: it
  # has no @tsm_path yet, and #{session_path} would match it to itself.
  local other="" sid sname spath
  while IFS=$'\t' read -r sid sname spath; do
    [ "$sid" != "$id" ] || continue
    [ -n "$spath" ] && [ "$spath" = "$path" ] || continue
    other="$sname"
    break
  done < <(tmux list-sessions -F $'#{session_id}\t#{session_name}\t#{@tsm_path}' 2>/dev/null)

  if [ -n "$other" ]; then
    # Every client on the session about to go away is moved first, so none of
    # them is detached along with it.
    local client
    while IFS= read -r client; do
      [ -n "$client" ] && tmux switch-client -c "$client" -t "=$other" 2>/dev/null
    done < <(tmux list-clients -t "$id" -F '#{client_name}' 2>/dev/null)

    tmux kill-session -t "$id" 2>/dev/null
    exit 0
  fi

  # Record the directory on the session itself; this is what identifies it.
  # The trailing `:` is load-bearing: set-option takes a target pane, and an
  # id alone is read as a pane id and fails to resolve, while `$id:` is that
  # session's current pane.
  tmux set-option -t "$id:" @tsm_path "$path"

  name=$(rename_created_session "$id" "$name" "$matching_file" "$path")

  local log_dir="$LOG_DIR/$name"
  local log_file="$log_dir/tsm.log"
  mkdir -p "$log_dir"
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting session '$name' ($(config_name_for_file "$matching_file"))" > "$log_file"

  # Subshell so a configuration aborting under its own `set -e` does not tear
  # down a session tmux already created. The cleanup record is written inside
  # it: it is only owed once the configuration has actually been applied, and
  # it is what the session-closed hook reads to know a `kill` is due.
  (
    export SESSION="$name" ROOT="$path"
    run_config "$matching_file" start

    if [ -n "$pid" ] && [ -n "$id" ]; then
      record=$(session_record "$pid" "$id")
      mkdir -p "$(dirname "$record")"
      printf '%s\n' "$path" > "$record"
    fi
  ) >> "$log_file" 2>&1
}

rename_created_session() {
  # Give a session the name its configuration asks for, and echo the name it
  # ends up with.
  #
  # A name that is already taken is kept rather than resolved: the hook has
  # no terminal to prompt on, and a session left under the name tmux gave it
  # is still a working session. It is said out loud instead, on the status
  # line and in the log.
  #
  # Args:
  #   $1: id: the session id
  #   $2: name: the name tmux gave it
  #   $3: file: the configuration claiming the directory
  #   $4: path: the directory the session was created at
  local id="$1" name="$2" file="$3" path="$4"

  # A name tmux made up for itself is a plain integer; anything else was
  # asked for, by `-s` or by `tsm at -p`, and is not tsm's to overwrite.
  case "$name" in
    '' | *[!0-9]*) printf '%s\n' "$name"; return ;;
  esac
  if tmux show-environment -t "$id" TSM_NAME_FIXED > /dev/null 2>&1; then
    printf '%s\n' "$name"
    return
  fi

  local want=""
  want=$(config_session_name "$file" "$path")
  [ -n "$want" ] || want=$(default_session_name "$path")
  [ -n "$want" ] && [ "$want" != "$name" ] || { printf '%s\n' "$name"; return; }

  if tmux has-session -t "=$want" 2>/dev/null; then
    notify "tsm: '$want' is taken; session at $path left as '$name'"
    printf '%s\n' "$name"
    return
  fi

  tmux rename-session -t "$id" "$want" 2>/dev/null || { printf '%s\n' "$name"; return; }
  printf '%s\n' "$want"
}

session_closed() {
  # The session-closed hook, called back by tmux. Runs the `kill` verb of the
  # configuration claiming the directory the closed session was started at.
  #
  # The configuration is resolved again here rather than remembered from
  # `start`, so the file that claims the directory now is the one that cleans
  # up after it.
  #
  # Args:
  #   $1: id: the closed session's id, #{hook_session}
  #   $2: pid: the tmux server's pid, #{pid}
  #   $3: session: the closed session's name, #{hook_session_name}
  local id="$1" pid="$2" session="$3"

  local record
  record=$(session_record "$pid" "$id")

  # No record: no configuration built this session -- it claimed no
  # directory, was created with -c, or tsm did not create it at all. Nothing
  # is owed, and every session tmux closes reaches this.
  [ -f "$record" ] || exit 0

  local root
  root=$(cat "$record")
  rm -f "$record"
  [ -n "$root" ] || exit 0

  local session_file
  session_file=$(matching_config_for_root "$root") || exit 0

  local log_dir="$LOG_DIR/$session"
  local log_file="$log_dir/tsm.log"
  mkdir -p "$log_dir"
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Killing session '$session' ($(config_name_for_file "$session_file"))" > "$log_file"

  # Backgrounded so tmux's run-shell returns at once and the hook does not
  # hold up the server while cleanup runs. ROOT comes from the record, so
  # `kill` sees the ROOT that `start` saw.
  nohup env SESSION="$session" ROOT="$root" \
    "$session_file" kill >> "$log_file" 2>&1 &
}

match_configs() {
  # Print how a directory ranks against every configuration that claims it,
  # one "<score>\t<file>" per line, best first. Precedence depends on every
  # other file too, so being able to ask beats guessing.
  #
  # Args:
  #   $1: path: directory to test; defaults to the current directory
  local path="${1:-$PWD}"

  path="${path/#\~/$HOME}"

  local resolved
  if ! resolved=$(cd "$path" 2>/dev/null && pwd -P); then
    notify "Error: Directory '$path' does not exist"
    exit 1
  fi

  local ranked
  ranked=$(rank_configs_for_root "$resolved")

  # No match is an answer, not a failure, but the non-zero status makes it
  # testable, and saying so on stderr keeps stdout clean for callers.
  if [ -z "$ranked" ]; then
    notify "No configuration claims $resolved"
    exit 1
  fi

  printf '%s\n' "$ranked"
}

###################################################
# the session: where every path ends up #
###################################################

session_at() {
  # Switch to the session already open at a directory, or create one there.
  #
  # Args:
  #   $1: path: the directory to start the session at
  #   $@: --no-config, --prompt-name
  local selected="$1"
  shift

  local no_config="" prompt_name="" arg
  for arg in "$@"; do
    case "$arg" in
      --no-config) no_config=1 ;;
      --prompt-name) prompt_name=1 ;;
    esac
  done

  selected="${selected/#\~/$HOME}"

  # Resolved here rather than by the caller: a session is identified by the
  # directory it was started at, so every path has to arrive in the same
  # form no matter who printed it.
  local resolved
  if ! resolved=$(cd "$selected" 2>/dev/null && pwd -P); then
    notify "Error: Directory '$selected' does not exist"
    exit 1
  fi
  selected="$resolved"

  # A session is identified by the directory it was started at, not by its
  # name: naming a directory that already has a session returns to it,
  # whatever it has been renamed to. Nothing is being created, so this is
  # also the answer -p gets.
  local existing
  if existing=$(session_for_path "$selected"); then
    switch_or_attach "=$existing"
    exit 0
  fi

  # A configuration may claim the path, and if one does the session-created
  # hook applies it: naming the session, building it and recording it. That
  # happens for any `tmux new-session`, so all that is left here is the two
  # things a hook cannot do -- size the session for the client that is about
  # to attach, and prompt for a name.
  local new_args=()

  # -c travels in the session environment, which is where the hook looks:
  # nothing a client exports can reach a hook, the server being its parent.
  [ -n "$no_config" ] && new_args+=(-e TSM_NO_CONFIG=1)

  local matching_file=""
  [ -n "$no_config" ] || matching_file=$(matching_config_for_root "$selected") || matching_file=""

  # A configuration claims the path but nothing would apply it, which is a
  # baffling way to discover that `tsm init` is missing from tmux.conf.
  if [ -n "$matching_file" ] && ! hook_installed; then
    notify "Error: tsm init has not run on this tmux server; add 'run-shell \"tsm init\"' to your tmux.conf"
    exit 1
  fi

  local session_name=""
  if [ -n "$prompt_name" ]; then
    # -p is the last word, so the name is settled before the session exists
    # and the hook is told to leave it alone. The rules still make the
    # suggestion: the configuration's `name` if it has an opinion, the
    # directory's otherwise.
    [ -n "$matching_file" ] && session_name=$(config_session_name "$matching_file" "$selected")
    [ -n "$session_name" ] || session_name=$(default_session_name "$selected")

    # session_name_prompt returns rather than exits because an exit inside a
    # command substitution only ends the subshell.
    session_name=$(session_name_prompt "$selected" "$session_name") || exit 1
    new_args+=(-s "$session_name" -e TSM_NAME_FIXED=1)
  elif [ -z "$matching_file" ]; then
    # No configuration claims the path, so the hook will not touch this one
    # and the directory has to name it here. A name already taken is left to
    # tmux, which is what the hook does with a collision too.
    session_name=$(default_session_name "$selected")
    if [ -n "$session_name" ] && ! tmux has-session -t "=$session_name" 2>/dev/null; then
      new_args+=(-s "$session_name")
    fi
  fi

  local width height
  read -r width height < <(client_size)

  # Sized up front: tmux creates detached sessions at 80x24, and percentage
  # splits made before the client attaches drift once the real size arrives.
  # This is the reason to come through tsm at all rather than run
  # `tmux new-session` and let the hook do the rest.
  local session_id
  session_id=$(tmux new-session -d -P -F '#{session_id}' -c "$selected" \
    ${width:+-x "$width"} ${height:+-y "$height"} ${new_args+"${new_args[@]}"}) || exit 1

  # A session no configuration claimed is never touched by the hook, so it is
  # marked here; the path is what identifies a session to `tsm at`.
  tmux set-option -t "$session_id:" @tsm_path "$selected"

  # Switched to by id: the hook may be renaming it at this very moment, and
  # an id survives that.
  switch_or_attach "$session_id"
}

at_path() {
  # Start a session at a directory, or switch to the session already open
  # there:
  #
  #   tsm at <path> [-c] [-p]
  #
  # A path and nothing else. Anything that prints a directory reaches this
  # through the shell: `tsm at "$(fzf-dir)"`.
  local session_flags=() paths=() arg
  expand_short_flags "$@"
  for arg in "${EXPANDED_ARGS[@]}"; do
    case "$arg" in
      -c | --no-config) session_flags+=(--no-config) ;;
      -p | --prompt-name) session_flags+=(--prompt-name) ;;
      -*)
        notify "Error: Unknown option '$arg' for 'tsm at'"
        exit 1
        ;;
      *) paths+=("$arg") ;;
    esac
  done

  if [ "${#paths[@]}" -gt 1 ]; then
    notify "Error: 'tsm at' takes one directory"
    exit 1
  fi

  # No directory is the answer a chooser gives when it declines -- pressing
  # escape leaves `tsm at "$(fzf-dir)"` with an empty argument, and an
  # unquoted substitution leaves it with none at all. Neither is an error,
  # and there is nothing to open.
  [ -n "${paths[0]:-}" ] || exit 0

  session_at "${paths[0]}" ${session_flags+"${session_flags[@]}"}
}

browse_logs() {
  local session="$1"

  local search_dir
  if [ -n "$session" ]; then
    search_dir="$LOG_DIR/$session"
    if [ ! -d "$search_dir" ]; then
      notify "Error: No log directory found for session '$session'"
      exit 1
    fi
  else
    search_dir="$LOG_DIR"
  fi

  local log_files
  log_files=$(find "$search_dir" -type f -name '*.log' 2>/dev/null | sed "s|^$LOG_DIR/||" | sort)

  if [ -z "$log_files" ]; then
    notify "No log files found"
    exit 1
  fi

  local selected
  selected=$(echo "$log_files" | fzf \
    --cycle \
    --bind=ctrl-d:preview-half-page-down \
    --bind=ctrl-u:preview-half-page-up \
    --bind="ctrl-o:execute(${EDITOR:-vi} '$LOG_DIR/{}')" \
    --prompt "Logs > " \
    --header $':: \e[33mEnter\e[0m to \e[31mtail\e[0m | \e[33mctrl-o\e[0m to \e[31mopen in editor\e[0m | \e[33mctrl-d\e[0m to \e[31mpreview page down\e[0m | \e[33mctrl-u\e[0m to \e[31mpreview page up\e[0m' \
    --preview "tail -n 100000 -f '$LOG_DIR/{}'" \
    --preview-window follow)

  if [ -z "$selected" ]; then
    exit 0
  fi

  tail -n 1000 -f "$LOG_DIR/$selected"
}

# Parse arguments
if [ $# -eq 0 ]; then
  usage
  exit 0
fi

command="$1"
shift

case "$command" in
  at)
    at_path "$@"
    ;;
  match)
    match_configs "$1"
    ;;
  logs)
    browse_logs "$1"
    ;;
  init)
    init_hook
    ;;
  "$HOOK_CREATED")
    session_created "$1" "$2" "$3"
    ;;
  "$HOOK_CLOSED")
    session_closed "$1" "$2" "$3"
    ;;
  help)
    usage
    ;;
  *)
    notify "Error: Unknown command '$command'"
    usage
    exit 1
    ;;
esac
