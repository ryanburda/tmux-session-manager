#!/bin/bash

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tsm"
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/tsm/logs"
mkdir -p "$CONFIG_DIR" "$LOG_DIR"

TSM_DIRS_CMD_DEFAULT='find "$HOME" -maxdepth 4 -name ".*" -prune -o -type d \( -exec test -e {}/.git \; -print -prune -o -print \)'
TSM_GIT_DIRS_CMD_DEFAULT='find "$HOME" -maxdepth 4 -name ".*" -prune -o -type d -exec test -e {}/.git \; -print -prune 2>/dev/null'
TSM_AGENT_CMDS_DEFAULT='claude codex aider cursor-agent opencode goose gemini amp crush copilot droid'
TSM_AGENT_STATE_OPT='@tsm_agent_state'

usage() {
  echo "Tmux Session Manager"
  echo ""
  echo "Usage"
  echo "  tsm                                  # Switch to session"
  echo "  tsm active [session]                 # Switch to session"
  echo "  tsm kill [session]                   # Kill session (run cleanup script if present)"
  echo "  "
  echo "  tsm dir [path] [--start-default]                      # Create session at path"
  echo "  tsm git [--hide-brief] [--no-fetch] [--start-default] # Browse git repositories with fzf, creates session at path"
  echo "  tsm worktree [name] [--start-default]                 # Create session at git worktree path"
  echo "  tsm zoxide [query] [--start-default]                  # Create session for zoxide match path"
  echo "  "
  echo "  tsm configured [config]              # Create configured session"
  echo "  tsm logs [session]                   # Browse configured session logs"
  echo "  tsm start-default                    # Run the shared default layout (for use inside a configuration's start())"
  echo "  "
  echo "  tsm agents                           # Browse panes running an AI agent"
  echo "  tsm agent-state [state]              # Record agent state on the current pane (for agent hooks)"
  echo "  "
  echo "  tsm help                             # Show help message"
  echo ""
  echo "See https://github.com/ryanburda/tmux-session-manager for more documentation"
}

####################
# helper functions #
####################
notify() {
  # Displays a message to the user.
  # Uses tmux display-message when running inside tmux, otherwise falls back to echo.
  local msg="$1"
  if [ -n "$TMUX" ]; then
    tmux display-message "$msg"
  else
    echo "$msg"
  fi
}

get_active_sessions() {
  # Lists active tmux session names, one per line.
  tmux ls 2>/dev/null | awk -F: '{print $1}'
}

switch_or_attach() {
  # Switches to a tmux session if inside tmux, otherwise attaches to it.
  local session="$1"
  if [ -n "$TMUX" ]; then
    tmux switch-client -t "=$session"
  else
    tmux attach-session -t "=$session"
  fi
}

sanitize_directory_session_name() {
  # Converts a directory path to a valid tmux session name by taking the
  # basename and replacing non-alphanumeric characters (except _ and -) with _.
  basename "$1" | tr -c 'a-zA-Z0-9_\-\n' '_'
}

client_size() {
  # Prints "WIDTH HEIGHT" for the client that will end up attaching, or
  # nothing if neither source can tell us.
  #
  # tmux creates detached sessions at 80x24, so a percentage split made before
  # the client attaches is computed against 80 columns and drifts toward 50/50
  # once the real size arrives. Sizing the session up front avoids that.
  local width height

  width=$(tmux display-message -p '#{client_width}' 2>/dev/null)
  height=$(tmux display-message -p '#{client_height}' 2>/dev/null)

  # Outside tmux there is no client to ask, so fall back to the terminal tsm
  # was invoked from.
  if [ -z "$width" ] || [ -z "$height" ]; then
    read -r height width < <({ stty size < /dev/tty; } 2>/dev/null)
  fi

  case "$width$height" in
    *[!0-9]* | '') return 1 ;;
  esac

  echo "$width $height"
}

git_brief(){
  # Returns a brief git status for the repo located in $1
  # Format: branch ↑ahead↓behind +insertions-deletions
  local dir="$1"
  local no_fetch="$2"
  local branch ahead behind stats added removed

  branch=$(git -C "$dir" branch --show-current 2>/dev/null) || return
  [ "$no_fetch" != "--no-fetch" ] && git -C "$dir" fetch --quiet 2>/dev/null
  ahead=$(git -C "$dir" log @{u}..HEAD --oneline 2>/dev/null | wc -l | tr -d ' ')
  behind=$(git -C "$dir" log HEAD..@{u} --oneline 2>/dev/null | wc -l | tr -d ' ')
  stats=$(git -C "$dir" diff --shortstat 2>/dev/null)
  added=$(echo "$stats" | grep -o '[0-9]* insertion' | grep -o '[0-9]*')
  removed=$(echo "$stats" | grep -o '[0-9]* deletion' | grep -o '[0-9]*')

  local blue='\033[34m' yellow='\033[33m' green='\033[32m' red='\033[31m' reset='\033[0m'
  local out="${blue}${branch}${reset}"
  [ "${ahead:-0}" -gt 0 ] && out+=" ${yellow}↑${ahead}${reset}"
  [ "${behind:-0}" -gt 0 ] && out+=" ${yellow}↓${behind}${reset}"
  [ "${added:-0}" -gt 0 ] && out+=" ${green}+${added}${reset}"
  [ "${removed:-0}" -gt 0 ] && out+=" ${red}-${removed}${reset}"
  printf '%b\n' "$out"
}

session_name_prompt() {
  # Prompts the user for a session name.
  # Provides a sensible default that can be used if no input is given.
  # Echoes the final session name.
  #
  # Args:
  #   $1: path — directory to derive the session name from
  local path="$1"
  local default_name

  local git_dir
  git_dir=$(git -C "$path" rev-parse --git-dir 2>/dev/null)

  if [ -n "$git_dir" ] && [ "$git_dir" != ".git" ]; then
    # Worktree — git_dir is absolute, e.g. /path/to/.bare/worktrees/wt_name
    local bare_repo_path
    bare_repo_path=$(dirname "$(dirname "$git_dir")")
    local bare_leaf
    bare_leaf=$(basename "$bare_repo_path")

    local repo_name
    if [ "$bare_leaf" = ".bare" ] || [ "$bare_leaf" = ".git" ]; then
      repo_name=$(basename "$(dirname "$bare_repo_path")")
    else
      repo_name="$bare_leaf"
    fi

    local worktree_name
    worktree_name=$(basename "$path")

    default_name="$(sanitize_directory_session_name "$repo_name")/${worktree_name}"
  else
    default_name=$(sanitize_directory_session_name "$path")
  fi

  local session_name="$default_name"
  printf "%s\n" "$(tput setaf 8)$path$(tput sgr0)" >&2
  while true; do
    local prompt="Enter session name"
    if ! tmux has-session -t "=$session_name" 2>/dev/null; then
      prompt="$prompt [$(tput setaf 4)${session_name}$(tput sgr0)]"
    fi
    read -rp "$prompt: " user_input
    session_name="${user_input:-$session_name}"
    if ! tmux has-session -t "=$session_name" 2>/dev/null; then
      break
    fi
    printf "$(tput setaf 1)Session '%s' already exists.$(tput sgr0)\n" "$session_name" >&2
  done
  echo "$session_name"
}

agent_panes() {
  # Lists tmux panes that are running an AI agent, one per line:
  #   state<TAB>pane_id<TAB>session:window:pane<TAB>command
  #
  # A pane qualifies if it has a recorded state (set by `tsm agent-state`
  # from the agent's notification hooks) or if a known agent command is found
  # anywhere in the pane's process tree. Panes matched only by process get the
  # state "unknown".
  local tab=$'\t'
  local fmt="#{${TSM_AGENT_STATE_OPT}}${tab}#{pane_id}${tab}#{pane_pid}${tab}#{session_name}:#{window_index}:#{pane_index}${tab}#{pane_current_command}"

  local panes
  panes=$(tmux list-panes -a -F "$fmt" 2>/dev/null)
  [ -n "$panes" ] || return

  # Build ^(claude|codex|...)$ from the configured agent command names.
  local pattern
  pattern=$(printf '%s' "${TSM_AGENT_CMDS:-$TSM_AGENT_CMDS_DEFAULT}" | tr -s '[:space:]' '|')
  pattern="${pattern#|}"
  pattern="^(${pattern%|})$"

  awk -F'\t' -v pat="$pattern" '
    # First input: pid, ppid, command name of every running process.
    FNR == NR { comm[$1] = $3; kids[$2] = kids[$2] " " $1; next }

    # Second input: one line per pane. Walk the pane process tree unless the
    # pane already carries a recorded state.
    {
      state = $1
      agent = (state != "")

      if (!agent) {
        delete seen; delete queue
        n = 0; i = 0
        queue[++n] = $3
        while (++i <= n) {
          p = queue[i]
          if (p in seen) continue
          seen[p] = 1
          if (comm[p] ~ pat) { agent = 1; break }
          m = split(kids[p], child, " ")
          for (j = 1; j <= m; j++) if (child[j] != "") queue[++n] = child[j]
        }
      }

      if (agent) printf "%s\t%s\t%s\t%s\n", (state == "" ? "unknown" : state), $2, $4, $5
    }
  ' <(ps -eo pid=,ppid=,comm= 2>/dev/null | awk '{print $1 "\t" $2 "\t" $3}') <(printf '%s\n' "$panes")
}

agent_state_label() {
  # Renders an agent state as a colored, fixed width status dot.
  case "$1" in
    blocked) printf '\033[31m● %-7s\033[0m' "$1" ;;
    working) printf '\033[33m● %-7s\033[0m' "$1" ;;
    done)    printf '\033[32m● %-7s\033[0m' "$1" ;;
    idle)    printf '\033[34m● %-7s\033[0m' "$1" ;;
    *)       printf '\033[90m● %-7s\033[0m' "$1" ;;
  esac
}

#################
# api functions #
#################
active_session() {
  local session="$1"

  # If no session provided, use fzf to select from active sessions
  if [ -z "$session" ]; then
    local active_sessions
    active_sessions=$(get_active_sessions)

    if [ -z "$active_sessions" ]; then
      notify "No active sessions"
      exit 1
    fi

    session=$(echo "$active_sessions" | fzf --cycle --prompt "Session > ")

    if [ -z "$session" ]; then
      exit 0
    fi
  fi

  if ! tmux has-session -t "=$session" 2>/dev/null; then
    notify "Error: Session '$session' is not running"
    exit 1
  fi

  switch_or_attach "$session"
}

kill_session() {
  local session="$1"

  # If no session provided, use fzf to select from active sessions
  if [ -z "$session" ]; then
    local active_sessions
    active_sessions=$(get_active_sessions)

    if [ -z "$active_sessions" ]; then
      notify "No active sessions to kill"
      exit 1
    fi

    session=$(echo "$active_sessions" | fzf --cycle --prompt "Kill Session > ")

    if [ -z "$session" ]; then
      exit 0
    fi
  fi

  if ! tmux has-session -t "=$session" 2>/dev/null; then
    notify "Error: Session '$session' is not running"
    exit 1
  fi

  local log_dir="$LOG_DIR/$session"
  local log_file="$log_dir/tsm.log"
  mkdir -p "$log_dir"

  # A configured session is normally named after its configuration file, so the
  # file could be found from the session name alone. The recorded name is what
  # keeps that true after a `tmux rename-session`.
  local configured_session
  configured_session=$(tmux show-environment -t "=$session" TSM_CONFIGURED_SESSION 2>/dev/null | sed 's/^TSM_CONFIGURED_SESSION=//')
  local session_file="$CONFIG_DIR/${configured_session:-$session}.sh"

  # Run the configuration's kill hook in the background if it defines one, so
  # the session goes away immediately rather than waiting on cleanup. tsm kills
  # the session itself either way — kill() is for everything around it.
  if [ -f "$session_file" ]; then
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Killing session '$session'" > "$log_file"
    nohup bash -c '
      export SESSION="$2"
      unset ROOT
      source "$1"
      [ $? -eq 0 ] || exit 1
      export ROOT="${ROOT:-$HOME}"
      if declare -F kill >/dev/null; then kill; fi
    ' tsm "$session_file" "$session" >> "$log_file" 2>&1 &
  fi

  tmux kill-session -t "=$session"
}

configured_session() {
  local config="$1"

  if [ ! -d "$CONFIG_DIR" ]; then
    notify "No sessions configured. Create files in $CONFIG_DIR"
    exit 1
  fi

  # If no config provided, use fzf to select from configured sessions
  if [ -z "$config" ]; then
    # A configuration's path under $CONFIG_DIR, minus the .sh, is the session
    # name — so nesting a configuration one directory deep is how a session
    # gets a name like "myrepo/base", matching what a worktree session is
    # called. -L because configurations are commonly symlinks into a project.
    local configured_sessions
    configured_sessions=$(find -L "$CONFIG_DIR" -type f -name '*.sh' ! -name '.start_default.sh' 2>/dev/null \
      | while read -r f; do f="${f#"$CONFIG_DIR/"}"; echo "${f%.sh}"; done \
      | sort)

    if [ -z "$configured_sessions" ]; then
      notify "No configured sessions"
      exit 1
    fi

    config=$(echo "$configured_sessions" | fzf --cycle --prompt "Configured Session > ")

    if [ -z "$config" ]; then
      exit 0
    fi
  fi

  local session_file="$CONFIG_DIR/$config.sh"

  if [ ! -f "$session_file" ]; then
    notify "Error: '$config' not found in $CONFIG_DIR"
    exit 1
  fi

  # The configuration file names the session — there is nothing for the
  # configuration itself to declare, and nothing to disagree about. The name
  # therefore has to be one tmux can address: '.' and ':' separate the window
  # and pane parts of a target, so a session called my.project is created fine
  # and then unreachable by every "=$session" target below.
  case "$config" in
    *[.:]*)
      notify "Error: '$config' cannot name a session — rename the file without '.' or ':'"
      exit 1
      ;;
  esac

  local session="$config"

  if tmux has-session -t "=$session" 2>/dev/null; then
    switch_or_attach "$session"
    return
  fi

  local log_dir="$LOG_DIR/$session"
  local log_file="$log_dir/tsm.log"
  mkdir -p "$log_dir"
  echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting session '$session'" > "$log_file"

  local width height
  read -r width height < <(client_size)

  # tsm owns the session's lifecycle: it creates the session here and kills it
  # in kill_session. start() is an optional hook that customizes the session
  # that already exists, so a configuration only has to describe what it wants
  # beyond a plain session rooted at $ROOT.
  #
  # SESSION is exported before the file is sourced so that top-level code can
  # use it, and ROOT afterwards so the configuration gets to set it first.
  # Exported rather than plain shell variables because `tlm` runs as a command
  # rather than a sourced library, and inherits them across that fork.
  #
  # ROOT is cleared first: it is a common enough name that the shell tsm was
  # invoked from may well have one of its own, and a configuration that sets no
  # ROOT should get $HOME rather than whatever happened to be in the
  # environment.
  #
  # set -m gives background jobs started by the configuration their own
  # process group.
  #
  # The source is a statement of its own, with its status checked after, rather
  # than `source ... || exit`. errexit does not apply inside a && / || list, so
  # sourcing that way would silently disable a configuration's own `set -e` for
  # the whole file.
  bash -c '
    set -m
    export SESSION="$2"
    unset ROOT
    source "$1"
    [ $? -eq 0 ] || exit 1
    export ROOT="${ROOT:-$HOME}"
    tmux new-session -d -s "$SESSION" -c "$ROOT" ${3:+-x "$3"} ${4:+-y "$4"} || exit 1
    if declare -F start >/dev/null; then start; else tsm start-default; fi
  ' tsm "$session_file" "$session" "$width" "$height" >> "$log_file" 2>&1

  # The session is missing only if it was never created — a configuration that
  # aborted under `set -e` before tsm got to it, or a tmux failure. Either way
  # the reason is the last thing in the log.
  if ! tmux has-session -t "=$session" 2>/dev/null; then
    notify "Error: '$config' did not start (see: tsm logs $session)"
    exit 1
  fi

  tmux set-environment -t "=$session" TSM_CONFIGURED_SESSION "$config"
  switch_or_attach "$session"
}

start_default_layout() {
  # Runs $CONFIG_DIR/.start_default.sh, a layout shared by configurations that
  # would otherwise all write the same start() body. It is a plain script, not
  # a function, sourced at the point a config calls `tsm start-default` --
  # SESSION and ROOT are already exported by configured_session() by then, the
  # same way tlm gets them.
  local default_file="$CONFIG_DIR/.start_default.sh"

  if [ ! -f "$default_file" ]; then
    notify "Error: no default layout at $default_file"
    exit 1
  fi

  source "$default_file"
}

dir_session() {
  local target_dir="" start_default=""
  for arg in "$@"; do
    case "$arg" in
      --start-default) start_default=1 ;;
      *) target_dir="$arg" ;;
    esac
  done

  local selected

  if [ -n "$target_dir" ]; then
    # Path provided, use it directly
    # Expand tilde if present
    selected="${target_dir/#\~/$HOME}"

    if [ ! -d "$selected" ]; then
      notify "Error: Directory '$selected' does not exist"
      exit 1
    fi
  else
    # No path provided, use fzf to select from TSM_DIRS_CMD or default
    local dirs_cmd="${TSM_DIRS_CMD:-$TSM_DIRS_CMD_DEFAULT}"

    # Use process substitution to allow killing the directory generator after fzf exits
    exec 3< <(eval "$dirs_cmd")
    local dirs_pid=$!
    selected=$(fzf --cycle --prompt "Directory > " <&3)
    kill "$dirs_pid" 2>/dev/null
    wait "$dirs_pid" 2>/dev/null
    exec 3<&-

    if [ -z "$selected" ]; then
      exit 0
    fi
  fi

  # Resolve to absolute path
  selected=$(cd "$selected" && pwd -P)

  # Create the session
  session_name=$(session_name_prompt "$selected")

  if [ -n "$start_default" ]; then
    # Sized up front, like configured_session does, so a percentage split in
    # the default layout is computed against the real client size rather than
    # tmux's 80x24 default for a detached session.
    local width height
    read -r width height < <(client_size)
    tmux new-session -d -s "$session_name" -c "$selected" ${width:+-x "$width"} ${height:+-y "$height"}

    # Run in a subshell: start_default_layout exits non-zero when there is no
    # default layout to run, and that should not tear down a session that
    # tmux already created.
    ( SESSION="$session_name" ROOT="$selected" start_default_layout )
  else
    tmux new-session -d -s "$session_name" -c "$selected"
  fi

  switch_or_attach "$session_name"
}

zoxide_session() {
  local query="" start_default=""
  for arg in "$@"; do
    case "$arg" in
      --start-default) start_default=1 ;;
      *) query="$arg" ;;
    esac
  done

  local selected

  if ! command -v zoxide &> /dev/null; then
    notify "Error: zoxide is not installed"
    exit 1
  fi

  if [ -n "$query" ]; then
    # Query provided, use zoxide query directly
    selected=$(zoxide query "$query" 2>/dev/null)

    if [ -z "$selected" ]; then
      notify "Error: No zoxide match found for '$query'"
      exit 1
    fi
  else
    # No query provided, use zoxide query -i for interactive selection
    selected=$(zoxide query -i 2>/dev/null)

    if [ -z "$selected" ]; then
      exit 0
    fi
  fi

  dir_session "$selected" ${start_default:+--start-default}
}

git_session() {
  local hide_brief="" no_fetch="" start_default=""
  for arg in "$@"; do
    case "$arg" in
      --hide-brief) hide_brief=1 ;;
      --no-fetch) no_fetch="--no-fetch" ;;
      --start-default) start_default=1 ;;
    esac
  done
  local git_dirs_cmd="${TSM_GIT_DIRS_CMD:-$TSM_GIT_DIRS_CMD_DEFAULT}"

  local dirs selected
  dirs=$(eval "$git_dirs_cmd" | sort)

  if [ -z "$dirs" ]; then
    notify "No git repositories found"
    exit 1
  fi

  if [ -n "$hide_brief" ]; then
    selected=$(echo "$dirs" | fzf --cycle --prompt "Repo > ")
  else
    if [ -z "$no_fetch" ]; then
      # Fetch in parallel, but bounded. Backgrounding one `git fetch` per repo
      # and then waiting forks the whole list at once — and each fetch forks an
      # ssh or git-remote-https child of its own — so a machine with a few
      # hundred repos under $HOME opens that many remote connections at once
      # and can run into the process limit. xargs keeps a fixed number in
      # flight instead. NUL separation so repo paths with spaces survive.
      printf '%s\n' "$dirs" | tr '\n' '\0' \
        | xargs -0 -P "${TSM_GIT_FETCH_JOBS:-8}" -n 1 \
                sh -c 'git -C "$1" fetch --quiet 2>/dev/null' _
    fi

    selected=$(echo "$dirs" \
      | while read -r dir; do
          printf '%s\t%s  %s\n' "$dir" "$dir" "$(git_brief "$dir" --no-fetch)"
        done \
      | fzf --ansi --cycle --delimiter=$'\t' --with-nth=2 --prompt "Repo > ")
    selected="${selected%%	*}"
  fi

  if [ -z "$selected" ]; then
    exit 0
  fi

  dir_session "$selected" ${start_default:+--start-default}
}

worktree_session() {
  local name="" start_default=""
  for arg in "$@"; do
    case "$arg" in
      --start-default) start_default=1 ;;
      *) name="$arg" ;;
    esac
  done

  local worktree_data
  worktree_data=$(git worktree list --porcelain | awk '
    /^worktree / { path = substr($0, 10); branch = "" }
    /^branch / { branch = substr($0, 8); sub("refs/heads/", "", branch) }
    /^bare$/ { path = "" }
    /^$/ { if (path != "") print path "\t" (branch != "" ? branch : "(detached)"); path = ""; branch = "" }
    END { if (path != "") print path "\t" (branch != "" ? branch : "(detached)") }
  ')

  if [ -z "$worktree_data" ]; then
    notify "No worktrees found"
    exit 0
  fi

  local selected
  if [ -n "$name" ]; then
    selected=$(echo "$worktree_data" | while IFS=$'\t' read -r wt _; do
      if [ "${wt##*/}" = "$name" ]; then
        echo "$wt"
        break
      fi
    done)

    if [ -z "$selected" ]; then
      notify "No worktree found matching '$name'"
      exit 1
    fi
  else
    # The header labels are measured alongside the values, so a column of
    # short worktree names still widens to fit `wt` rather than the label
    # overhanging it. fzf indents --header by the two columns its pointer
    # takes on the rows below, so the two line up with no padding of our own.
    local name_label='wt' branch_label='branch'
    local fzf_input header max_name=${#name_label} max_branch=${#branch_label}
    while IFS=$'\t' read -r wt branch; do
      local wt_name="${wt##*/}"
      (( ${#wt_name} > max_name )) && max_name=${#wt_name}
      (( ${#branch} > max_branch )) && max_branch=${#branch}
    done <<< "$worktree_data"
    fzf_input=$(echo "$worktree_data" | while IFS=$'\t' read -r wt branch; do
      printf '%s\t%-*s  \033[32m%-*s\033[0m  %s\n' "$wt" "$max_name" "${wt##*/}" "$max_branch" "$branch" "$wt"
    done)
    header=$(printf '%-*s  %-*s  %s' "$max_name" "$name_label" "$max_branch" "$branch_label" 'path')

    selected=$(echo "$fzf_input" | fzf --ansi --cycle --with-nth=2 --delimiter=$'\t' --prompt "Worktree > " --header "$header")

    if [ -z "$selected" ]; then
      exit 0
    fi

    selected="${selected%%	*}"
  fi

  dir_session "$selected" ${start_default:+--start-default}
}

browse_logs() {
  local session="$1"

  local search_dir
  if [ -n "$session" ]; then
    search_dir="$LOG_DIR/$session"
    if [ ! -d "$search_dir" ]; then
      notify "Error: No log directory found for session '$session'"
      exit 1
    fi
  else
    search_dir="$LOG_DIR"
  fi

  local log_files
  log_files=$(find "$search_dir" -type f -name '*.log' 2>/dev/null | sed "s|^$LOG_DIR/||" | sort)

  if [ -z "$log_files" ]; then
    notify "No log files found"
    exit 1
  fi

  local selected
  selected=$(echo "$log_files" | fzf \
    --cycle \
    --bind=ctrl-d:preview-half-page-down \
    --bind=ctrl-u:preview-half-page-up \
    --bind="ctrl-o:execute(${EDITOR:-vi} '$LOG_DIR/{}')" \
    --prompt "Logs > " \
    --header $':: \e[33mEnter\e[0m to \e[31mtail\e[0m | \e[33mctrl-o\e[0m to \e[31mopen in editor\e[0m | \e[33mctrl-d\e[0m to \e[31mpreview page down\e[0m | \e[33mctrl-u\e[0m to \e[31mpreview page up\e[0m' \
    --preview "tail -n 100000 -f '$LOG_DIR/{}'" \
    --preview-window follow)

  if [ -z "$selected" ]; then
    exit 0
  fi

  tail -n 1000 -f "$LOG_DIR/$selected"
}

agent_rows() {
  # Prints the picker's column header, then its rows ordered by
  # session:window:pane, one per line:
  #   pane_id<TAB>display
  #
  # The header comes out of here, as the first line and with an empty pane id,
  # because it is padded to the same column widths as the rows and it counts
  # toward them: `session:window:pane` is wider than a location like s1:1:1,
  # so a list of short locations widens to fit the label rather than the label
  # overhanging the column. agent_picker peels the line off for fzf --header.
  #
  # The sort is -V so that window 10 lands after window 2 rather than before
  # it, and it runs on the raw records — sorting the rendered rows would key
  # off the status dot's color escapes instead. The location's pane index is
  # for reading; the pane id in field 1 is what the picker actually targets.
  local agents
  agents=$(agent_panes | sort -t$'\t' -k3,3V)
  [ -n "$agents" ] || return

  # Widest location, the header label included, so the commands line up.
  local loc_label='session:window:pane'
  local max_loc=${#loc_label}
  while IFS=$'\t' read -r _ _ loc _; do
    [ ${#loc} -gt $max_loc ] && max_loc=${#loc}
  done <<< "$agents"

  # The state column is whatever agent_state_label emits: a dot and a space,
  # then the state padded to 7. The header mirrors that as two leading spaces
  # and its own 7 wide field, which puts `state` over the state names. 7 needs
  # no widening — it already exceeds `state`, and every state name fits it.
  printf '\t  %-7s  %-*s  %s\n' 'state' "$max_loc" "$loc_label" 'agent'

  while IFS=$'\t' read -r state pane loc cmd; do
    printf '%s\t%s  %-*s  %s\n' \
      "$pane" "$(agent_state_label "$state")" "$max_loc" "$loc" "$cmd"
  done <<< "$agents"
}

agent_picker() {
  # Browses panes running an AI agent with fzf and jumps to the selected pane.
  #
  # The list is a snapshot: states are read once, when the picker opens, so an
  # agent that finishes while you are looking at it keeps its old status dot.
  # Rows are built up front and reused for the empty check, since scanning is
  # the whole cost of opening the picker — a tmux pane list plus a full `ps`.
  local rows
  rows=$(agent_rows)

  if [ -z "$rows" ]; then
    notify "No agents running"
    exit 0
  fi

  # Split agent_rows' leading header line off from the rows it sizes.
  local header list
  header=$(printf '%s\n' "$rows" | head -n 1 | cut -f2-)
  list=$(printf '%s\n' "$rows" | tail -n +2)

  local selected
  selected=$(
    printf '%s\n' "$list" | fzf --ansi \
        --cycle \
        --delimiter=$'\t' \
        --with-nth=2 \
        --prompt "Agent > " --header "$header"
  )

  if [ -z "$selected" ]; then
    exit 0
  fi

  local pane
  pane=$(printf '%s' "$selected" | cut -f1)

  if [ -z "$pane" ]; then
    exit 0
  fi

  # Point the target session at the right window and pane, then switch to it.
  tmux select-window -t "$pane"
  tmux select-pane -t "$pane"
  switch_or_attach "$(tmux display-message -p -t "$pane" '#{session_name}')"
}

notification_state() {
  # Maps a Claude Code Notification hook payload (JSON on stdin) to an agent
  # state, echoing it. Echoes nothing for notifications that say nothing about
  # whether the agent wants you, so the caller leaves the current state alone.
  #
  # The Notification event covers more than "the agent needs you" — it also
  # fires after messageIdleNotifThresholdMs (60s by default) of sitting at the
  # prompt, and for auth/quota chatter. Mapping the whole event to one state is
  # what makes every agent eventually look blocked.
  local payload type message

  # Never block on a terminal when invoked by hand.
  [ -t 0 ] || payload=$(cat 2>/dev/null | tr -d '\n')
  [ -n "$payload" ] || return

  type=$(printf '%s' "$payload" | sed -n 's/.*"notification_type"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')

  case "$type" in
    permission_prompt|worker_permission_prompt|agent_needs_input) echo blocked ;;
    idle_prompt) echo idle ;;
    agent_completed) echo done ;;
    "")
      # Older releases sent no notification_type — fall back to the message.
      message=$(printf '%s' "$payload" | sed -n 's/.*"message"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p')
      case "$message" in
        *permission*) echo blocked ;;
        *"waiting for your input"*) echo idle ;;
      esac
      ;;
  esac
}

record_agent_state() {
  # Records an AI agent's state on the tmux pane it is running in, so that
  # `tsm agents` can show it. Meant to be called from an agent's notification
  # hooks — see the README for a Claude Code configuration.
  #
  # Args:
  #   $1: state — working|blocked|done|idle|clear, or `notification` to derive
  #       the state from a Claude Code Notification payload on stdin
  #
  # Never fails: a non-zero exit here would surface as an error in the agent.
  local state="$1"

  if [ "$state" = "notification" ]; then
    state=$(notification_state)
    # Nothing actionable in the payload — leave the pane as it is.
    [ -n "$state" ] || exit 0
  fi

  if [ -n "$TMUX_PANE" ]; then
    case "$state" in
      working|blocked|done|idle)
        tmux set-option -p -t "$TMUX_PANE" "$TSM_AGENT_STATE_OPT" "$state" 2>/dev/null
        ;;
      clear)
        tmux set-option -pu -t "$TMUX_PANE" "$TSM_AGENT_STATE_OPT" 2>/dev/null
        ;;
    esac
  fi
  exit 0
}

# Parse arguments
if [ $# -eq 0 ]; then
  active_session
  exit 0
fi

command="$1"
shift

case "$command" in
  active)
    active_session "$1"
    ;;
  kill)
    kill_session "$1"
    ;;
  dir)
    dir_session "$@"
    ;;
  git)
    git_session "$@"
    ;;
  worktree)
    worktree_session "$@"
    ;;
  zoxide)
    zoxide_session "$@"
    ;;
  configured)
    configured_session "$1"
    ;;
  logs)
    browse_logs "$1"
    ;;
  start-default)
    start_default_layout
    ;;
  agents)
    agent_picker
    ;;
  agent-state)
    record_agent_state "$1"
    ;;
  help)
    usage
    ;;
  *)
    notify "Error: Unknown command '$command'"
    usage
    exit 1
    ;;
esac
