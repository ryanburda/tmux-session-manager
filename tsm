#!/bin/bash

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tsm"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/tsm"
LOG_DIR="$STATE_DIR/logs"
HISTORY_FILE="$STATE_DIR/session_history"
BOOKMARKS_FILE="$STATE_DIR/bookmarks.json"
mkdir -p "$CONFIG_DIR" "$LOG_DIR"

TSM_DIRS_CMD_DEFAULT='find "$HOME" -maxdepth 4 -name ".*" -prune -o -type d \( -exec test -e {}/.git \; -print -prune -o -print \)'
TSM_GIT_DIRS_CMD_DEFAULT='find "$HOME" -maxdepth 4 -name ".*" -prune -o -type d -exec test -e {}/.git \; -print -prune 2>/dev/null'

usage() {
  echo "Tmux Session Manager"
  echo ""
  echo "Usage"
  echo "  tsm                                      # Show help message"
  echo "  tsm active [session]                     # Switch to session"
  echo "  tsm kill [session]                       # Kill session (run cleanup script if present)"
  echo "  tsm last                                 # Switch to the most recent session that is still open"
  echo "  "
  echo "  tsm dir [path] [-c] [-p]                 # Create session at path"
  echo "  tsm git [path] [-b] [-f] [-c] [-p]       # Browse git repositories with fzf, creates session at path"
  echo "  tsm worktree [name] [-c] [-p]            # Create session at git worktree path"
  echo "  tsm bookmark [char] [-c] [-p]            # Create session at a bookmarked directory (prompts for char)"
  echo "  "
  echo "    -c, --no-config                        # Ignore any configuration claiming the selected path"
  echo "    -p, --prompt-name                      # Prompt for the session name instead of using the default"
  echo "    -b, --brief                            # (git) Show git status information in the picker"
  echo "    -f, --fetch                            # (git) Fetch before showing the brief; implies -b"
  echo "  "
  echo "  tsm bookmark-add [char] [path]           # Bookmark a directory (prompts for char; path defaults to the current directory)"
  echo "  tsm bookmark-remove [char]               # Remove a bookmark (prompts for char)"
  echo "  tsm bookmark-list [-f]                   # List bookmarks (-f, --fzf: browse them with fzf and start a session)"
  echo "  tsm bookmark-status [path]               # Bookmarks of the open sessions, for a tmux status line (-s, -c set its styles)"
  echo "  "
  echo "  tsm logs [session]                       # Browse session logs"
  echo "  tsm apply-matching-config                # Apply the matching configuration's start (inside a configuration's start)"
  echo "  tsm kill-matching-config                 # Run the matching configuration's kill (inside a configuration's kill)"
  echo "  "
  echo "  tsm help                                 # Show help message"
  echo ""
  echo "See https://github.com/ryanburda/tmux-session-manager for more documentation"
}

####################
# helper functions #
####################
notify() {
  # Displays a message to the user.
  # Uses tmux display-message when running inside tmux, otherwise falls back to echo.
  #
  # The echo goes to stderr because several of the functions that report this
  # way run inside a command substitution -- naming a session, mostly -- where
  # stdout is the return value and a message written to it is read as the
  # answer rather than shown to anyone. Nothing consumes a notify's output.
  local msg="$1"
  if [ -n "$TMUX" ]; then
    tmux display-message "$msg"
  else
    echo "$msg" >&2
  fi
}

get_active_sessions() {
  # Lists active tmux session names, one per line. Formatted rather than cut
  # out of `tmux ls` output, which would split a name at its first colon.
  tmux list-sessions -F '#{session_name}' 2>/dev/null
}

prune_history() {
  # Drops sessions that are no longer running from HISTORY_FILE, so the
  # history only ever holds sessions that could still be switched to.
  [ -f "$HISTORY_FILE" ] || return 0

  local active
  active=$(get_active_sessions)

  # Whole-line keys, so a session name is never read as a pattern. Passed
  # through the environment rather than -v, which would expand a backslash
  # in a session name as an escape sequence.
  TSM_ACTIVE="$active" awk '
    BEGIN {
      n = split(ENVIRON["TSM_ACTIVE"], names, "\n")
      for (i = 1; i <= n; i++) live[names[i]]
    }
    $0 in live
  ' "$HISTORY_FILE" > "$HISTORY_FILE.tmp" && mv "$HISTORY_FILE.tmp" "$HISTORY_FILE"
}

record_switch() {
  # Appends the session being switched away from to HISTORY_FILE, so `tsm
  # last` can still find it later even if whatever replaces it as the
  # current session is itself closed before `tsm last` is used.
  #
  # Called from the client-session-changed hook, which the user's tmux.conf
  # is responsible for registering (see README). That hook is what makes
  # this fire for every switch on the server.
  #
  # Args:
  #   $1: from: the session that was left, already shell-quoted by tmux's
  #       #{q:} format modifier before it ever became shell text
  #   $2: to: the session that was switched to
  local from="$1" to="$2"

  [ -n "$from" ] && [ "$from" != "$to" ] || return

  # Validated on every write. This, plus the dedupe below, is what bounds
  # the file: it holds one line per session that is currently running.
  prune_history

  # Compacted on every write. Drops any earlier occurrence of this session
  # before appending it. This prevents the history file from containing
  # duplicates of the same session name when only its most recent position
  # matters for tsm last's walk-back.
  #
  # -F/-x match the whole line literally, since a session name
  # could otherwise be read as a regex.
  if [ -f "$HISTORY_FILE" ]; then
    grep -Fxv -- "$from" "$HISTORY_FILE" > "$HISTORY_FILE.tmp" 2>/dev/null
    mv "$HISTORY_FILE.tmp" "$HISTORY_FILE"
  fi

  echo "$from" >> "$HISTORY_FILE"
}

refresh_status() {
  # Redraws every attached client's status line, re-running the commands in
  # it. Called from the tmux hooks that fire when the set of sessions changes,
  # which the user's tmux.conf is responsible for registering (see README), so
  # that a status line holding `tsm bookmark-status` shows a session appearing
  # or disappearing as it happens rather than at the next status-interval.
  #
  # Every client, one at a time, because tmux's own refresh-client reaches
  # only the client the hook fired for, and the rest are showing a line that
  # is just as out of date. A status line that passes #{session_path} makes
  # each client's #() a job of its own, so refreshing one client's does not
  # touch what the others are showing.
  local client

  while IFS= read -r client; do
    [ -n "$client" ] && tmux refresh-client -S -t "$client" 2>/dev/null
  done < <(tmux list-clients -F '#{client_name}' 2>/dev/null)
}

switch_or_attach() {
  # Switches to a tmux session if inside tmux, otherwise attaches to it.
  local session="$1"
  if [ -n "$TMUX" ]; then
    tmux switch-client -t "=$session"
  else
    tmux attach-session -t "=$session"
  fi
}

session_paths() {
  # Emits "<session name>\t<path>" for every running session.
  #
  # The path is the one tsm recorded in the session's @tsm_path option when it
  # created the session. #{session_path} is the fallback, for a session tsm did
  # not create or one that predates the option: it is only ever the directory
  # the session's first pane started in, and it drifts as soon as that pane cds
  # somewhere else, which is exactly why @tsm_path exists.
  tmux list-sessions -F $'#{session_name}\t#{@tsm_path}\t#{session_path}' 2>/dev/null \
    | while IFS=$'\t' read -r name recorded fallback; do
        printf '%s\t%s\n' "$name" "${recorded:-$fallback}"
      done
}

session_for_path() {
  # Echoes the name of the running session started at $1, or nothing with a
  # non-zero status. This is what makes a path, rather than a name, the identity
  # of a session: picking a directory twice returns to the session already open
  # there however it has since been renamed.
  #
  # Compared in the shell rather than with a `-f "#{==:...}"` filter because a
  # path is arbitrary text and tmux's filter parser reads `,` and `}` in it.
  local want="$1" name path
  while IFS=$'\t' read -r name path; do
    [ "$path" = "$want" ] || continue
    printf '%s\n' "$name"
    return 0
  done < <(session_paths)
  return 1
}

path_for_session() {
  # The reverse of session_for_path: echoes the path the session named $1 was
  # started at, or nothing with a non-zero status.
  local want="$1" name path
  while IFS=$'\t' read -r name path; do
    [ "$name" = "$want" ] || continue
    printf '%s\n' "$path"
    return 0
  done < <(session_paths)
  return 1
}

sanitize_session_name() {
  # Makes $1 usable as a tmux session name by replacing every character outside
  # [A-Za-z0-9_-/] with _.
  #
  # `/` survives because a worktree session is named repo/worktree and tmux is
  # happy to hold one. `.` and `:` do not: tmux target syntax is
  # session:window.pane, so a name holding either could be created and then
  # never switched to or killed again.
  #
  # Takes a name, not a path -- callers take the basename themselves, because
  # the worktree case needs to sanitize two halves separately and join them with
  # a `/` this would otherwise have nothing to say about.
  printf '%s' "$1" | tr -c 'a-zA-Z0-9_/-' '_'
}

client_size() {
  # Prints "WIDTH HEIGHT" for the client that will end up attaching, or
  # nothing if neither source can tell us.
  #
  # tmux creates detached sessions at 80x24, so a percentage split made before
  # the client attaches is computed against 80 columns and drifts toward 50/50
  # once the real size arrives. Sizing the session up front avoids that.
  local width height

  width=$(tmux display-message -p '#{client_width}' 2>/dev/null)
  height=$(tmux display-message -p '#{client_height}' 2>/dev/null)

  # Outside tmux there is no client to ask, so fall back to the terminal tsm
  # was invoked from.
  if [ -z "$width" ] || [ -z "$height" ]; then
    read -r height width < <({ stty size < /dev/tty; } 2>/dev/null)
  fi

  case "$width$height" in
    *[!0-9]* | '') return 1 ;;
  esac

  # A pty with no size set answers `0 0`, and tmux refuses to create a session
  # that wide. Answering nothing instead lets it use its own default, which is
  # what every caller here already handles.
  [ "$width" -gt 0 ] && [ "$height" -gt 0 ] || return 1

  echo "$width $height"
}

tsm_self() {
  # Echoes the path to re-run tsm by. The name it was invoked as is resolved
  # against the current PATH when it is a bare name, because the commands tsm
  # hands to tmux and to fzf are run later, in an environment whose PATH is
  # not necessarily this one.
  local self="$0"

  case "$self" in
    */*) ;;
    *) self=$(command -v -- "$self" 2>/dev/null) || self="$0" ;;
  esac

  echo "$self"
}

tmux_command_string() {
  # Escapes a shell command for use as a double-quoted argument to a tmux
  # command that expands formats -- run-shell, here.
  #
  # Two layers read it before a shell does: tmux's parser, which acts on \, "
  # and $ inside double quotes, and the format expander, where # introduces a
  # #{...} substitution and ## is how a literal one is written.
  local s="$1" out="" i c

  for (( i = 0; i < ${#s}; i++ )); do
    c="${s:i:1}"
    case "$c" in
      '\' | '"' | '$') out="$out\\$c" ;;
      '#') out="$out##" ;;
      *) out="$out$c" ;;
    esac
  done

  printf '%s' "$out"
}

expand_short_flags() {
  # Splits clustered short flags (e.g. -bfnp) into single-letter flags so the
  # subcommand parsers only ever see one flag per argument. Everything else --
  # long flags, paths, names -- passes through untouched. The result lands in
  # the EXPANDED_ARGS array because paths may contain whitespace.
  EXPANDED_ARGS=()
  local arg i
  for arg in "$@"; do
    case "$arg" in
      -[!-]*)
        for (( i = 1; i < ${#arg}; i++ )); do
          EXPANDED_ARGS+=("-${arg:i:1}")
        done
        ;;
      *) EXPANDED_ARGS+=("$arg") ;;
    esac
  done
}

git_brief(){
  # Returns a brief git status for the repo located in $1
  # Format: branch ↑ahead↓behind +insertions-deletions
  local dir="$1"
  local no_fetch="$2"
  local branch ahead behind stats added removed

  branch=$(git -C "$dir" branch --show-current 2>/dev/null) || return
  [ "$no_fetch" != "--no-fetch" ] && git -C "$dir" fetch --quiet 2>/dev/null
  ahead=$(git -C "$dir" log @{u}..HEAD --oneline 2>/dev/null | wc -l | tr -d ' ')
  behind=$(git -C "$dir" log HEAD..@{u} --oneline 2>/dev/null | wc -l | tr -d ' ')
  stats=$(git -C "$dir" diff --shortstat 2>/dev/null)
  added=$(echo "$stats" | grep -o '[0-9]* insertion' | grep -o '[0-9]*')
  removed=$(echo "$stats" | grep -o '[0-9]* deletion' | grep -o '[0-9]*')

  local blue='\033[34m' yellow='\033[33m' green='\033[32m' red='\033[31m' reset='\033[0m'
  local out="${blue}${branch}${reset}"
  [ "${ahead:-0}" -gt 0 ] && out+=" ${yellow}↑${ahead}${reset}"
  [ "${behind:-0}" -gt 0 ] && out+=" ${yellow}↓${behind}${reset}"
  [ "${added:-0}" -gt 0 ] && out+=" ${green}+${added}${reset}"
  [ "${removed:-0}" -gt 0 ] && out+=" ${red}-${removed}${reset}"
  printf '%b\n' "$out"
}

default_session_name() {
  # Derives the session name for a directory: repo/worktree for a linked
  # worktree, the sanitized basename for anything else. Echoes the name.
  #
  # Both halves of the worktree name come from paths -- the directory the
  # repository lives in, and the directory the worktree lives in. Two worktrees
  # whose paths end in the same segment therefore derive the same name, and
  # that is fine: a session is identified by its path, so the second one picked
  # is caught as a name collision and named by hand rather than silently
  # switching to the first.
  #
  # Args:
  #   $1: path: directory to derive the session name from
  local path="$1"

  local git_dir
  git_dir=$(git -C "$path" rev-parse --absolute-git-dir 2>/dev/null)

  # A linked worktree's git dir is <common dir>/worktrees/<internal name> and
  # holds the gitdir file pointing back at the worktree. Both are tested
  # rather than taking any absolute answer to mean "worktree": inside a
  # subdirectory of an ordinary repo rev-parse also answers absolutely.
  if [ -n "$git_dir" ] && [ -f "$git_dir/gitdir" ] &&
    [ "$(basename "$(dirname "$git_dir")")" = "worktrees" ]; then
    local repo_dir
    repo_dir=$(dirname "$(dirname "$git_dir")")
    local repo_leaf
    repo_leaf=$(basename "$repo_dir")

    # The repository's directory is what names the first half, so the
    # conventional wrappers around a bare repo are stepped over: worktrees of
    # ~/code/api/.bare belong to `api`, not to `.bare`.
    local repo_name
    if [ "$repo_leaf" = ".bare" ] || [ "$repo_leaf" = ".git" ]; then
      repo_name=$(basename "$(dirname "$repo_dir")")
    else
      repo_name="$repo_leaf"
    fi

    # Sanitized separately, so the `/` joining them is the only one the name is
    # given: a worktree directory named for a branch like v1.2 would otherwise
    # put a period in a session name tmux reads as a pane separator.
    echo "$(sanitize_session_name "$repo_name")/$(sanitize_session_name "$(basename "$path")")"
  else
    sanitize_session_name "$(basename "$path")"
  fi
}

config_files() {
  # Emits the paths of the configuration files under $CONFIG_DIR,
  # LC_ALL=C sorted, one per line.
  #
  # A configuration is an executable program: tsm runs it with a verb and reads
  # its answer.
  #
  # `-L` because configurations are commonly symlinks into a project.
  # `-perm -u+x` rather than `-executable` because the latter is GNU-only.
  #
  # Which file wins a contest is a matter of what it is called, so the sort is
  # pinned to LC_ALL=C. A locale-aware sort collates on the full path with
  # punctuation ignored in the first pass, which puts a nested `sub/work` ahead
  # of a top-level `zz-default` in en_US.UTF-8 and behind it in C. Precedence
  # should not depend on the environment tsm happens to be run from.
  [ -d "$CONFIG_DIR" ] || return

  find -L "$CONFIG_DIR" -type f -perm -u+x 2>/dev/null | LC_ALL=C sort
}

config_name_for_file() {
  # Echoes the configuration name a file path carries: its path under
  # $CONFIG_DIR with any final extension removed. Nesting a configuration one
  # directory deep is how a session gets a name like "myrepo/base", matching
  # what a worktree session is called.
  #
  # The extension is the user's business rather than tsm's. It is there so an
  # editor knows what to highlight. This means `work`, `work.sh` and `work.fish` all
  # name the session `work`.
  #
  # A leading dot is not an extension, so a hidden file keeps its name rather
  # than having all of it eaten: `.work` is the configuration `.work`, and
  # `.work.fish` is `.work` too.
  #
  # Args:
  #   $1: file: path to a configuration file under $CONFIG_DIR
  local rel base dir="" dot=""
  rel="${1#"$CONFIG_DIR/"}"

  base="${rel##*/}"
  [ "$base" = "$rel" ] || dir="${rel%/*}/"

  case "$base" in .*) dot="."; base="${base#.}" ;; esac
  case "$base" in *.*) base="${base%.*}" ;; esac

  printf '%s%s%s\n' "$dir" "$dot" "$base"
}

config_file_for_name() {
  # Echoes the path of the configuration called $1, or nothing with a non-zero
  # status if no executable file under $CONFIG_DIR carries that name.
  #
  # The reverse of config_name_for_file, and a search rather than a
  # substitution because the extension is not knowable from the name: `work`
  # could be work, work.sh or work.fish. First match in LC_ALL=C order wins,
  # the same rule everything else here uses.
  #
  # Args:
  #   $1: name: a configuration name, as config_name_for_file produces
  local want="$1" file
  while IFS= read -r file; do
    if [ "$(config_name_for_file "$file")" = "$want" ]; then
      printf '%s\n' "$file"
      return 0
    fi
  done < <(config_files)
  return 1
}

run_config() {
  # Runs a configuration with a verb.
  #
  # The contract is argv in, stdout and exit status out, which is what lets a
  # configuration be written in any language: tsm never looks inside it.
  #
  #   pattern  print the ERE of directories this configuration claims
  #   name     print the session name for the directory given as $2
  #   start    build the layout; the session already exists
  #   kill     tear down whatever start built
  #
  # A verb a configuration does not handle must leave a zero status. That is
  # how "no hook for this" is said, in place of the absent shell function the
  # sourced contract used to look for. It also means an existing configuration
  # handling only `pattern` and `start` answers `name` correctly without being
  # touched: the `case` falls through and the default naming applies.
  #
  # Only `pattern` and `name` treat stdout as a return channel. For `start` and
  # `kill` it is the session log, and callers redirect it there.
  #
  # SESSION, and for `start` and `kill` also ROOT, are expected in the
  # environment already; callers export them on the way in.
  #
  # set -m gives background jobs the configuration starts their own process
  # group, and the subshell keeps a configuration that exits from taking tsm
  # with it.
  #
  # Args:
  #   $1: file: path to the configuration
  #   $2: verb: one of pattern, name, start, kill
  #   $@: any further arguments the verb takes
  local file="$1" verb="$2"
  shift 2
  ( set -m; exec "$file" "$verb" "$@" )
}

matching_config_for_root() {
  # Echoes the path of the configuration whose pattern matches the given
  # directory, or nothing if none does. Files are tried in sorted order and the
  # first match wins.
  #
  # A configuration describes a set of directories with `pattern`, a POSIX
  # extended regular expression tested against the resolved path. It is the way
  # to say "every repository under ~/code/work gets this layout" without a file
  # per repository. Nothing claims a directory by default: a path no pattern
  # matches gets a bare session.
  #
  # `grep -Eq` rather than bash's `[[ =~ ]]` so that a pattern means the same
  # thing whatever language printed it. The `--` keeps a pattern beginning with
  # `-` from being read as an option, and printf rather than echo keeps the
  # path from being eaten the same way. A configuration that fails, prints
  # nothing, or prints something that is not a valid regex all leave a non-zero
  # status, which is to say they simply do not match.
  #
  # $2 resumes the search after a file instead of starting at the top, which is
  # what `tsm apply-matching-config` is: a configuration asking for the next one
  # along that also claims this directory. Without it a configuration calling
  # that command would match itself and recurse forever, since it is in the same
  # list as everything else. Skipping to just past itself also makes the answer
  # the one precedence already implies -- the specific file falls through to the
  # general one behind it, and a chain of them keeps falling through.
  #
  # Args:
  #   $1: path: the resolved directory a session would be rooted at
  #   $2: after: optional; skip every file up to and including this one
  local path="$1" after="$2"

  local file pattern skipping=""
  [ -n "$after" ] && skipping=1

  while IFS= read -r file; do
    if [ -n "$skipping" ]; then
      [ "$file" = "$after" ] && skipping=""
      continue
    fi

    pattern=$(
      export SESSION=""
      unset ROOT
      run_config "$file" pattern 2>/dev/null
    ) || continue

    [ -n "$pattern" ] || continue

    if printf '%s' "$path" | grep -Eq -- "$pattern" 2>/dev/null; then
      printf '%s\n' "$file"
      return 0
    fi
  done < <(config_files)

  return 1
}

config_session_name() {
  # Echoes the session name the configuration $1 gives the directory $2, or
  # nothing with a non-zero status when it has no opinion.
  #
  # The directory arrives both as the verb's argument and as ROOT, so a `name`
  # implementation can read whichever suits it. SESSION is unset rather than
  # exported: it is the thing being computed, and a configuration answering
  # `name` with the value of SESSION would be answering with nothing at all.
  #
  # Only the first line is read and its surrounding whitespace trimmed, the
  # same as `pattern`. A configuration that prints nothing, or that fails, is
  # not an error -- a naming scheme with no opinion about a particular
  # directory is a normal thing to write, and the default naming takes over.
  #
  # What it does print is sanitized rather than refused. A session name is
  # derived from things a configuration does not control -- a branch, a
  # directory -- and `feature/v1.2` is a reasonable thing to hand back and an
  # unreasonable thing to fail over.
  #
  # Args:
  #   $1: file: path to the configuration
  #   $2: path: the resolved directory the configuration matched
  local file="$1" path="$2" name

  name=$(
    export ROOT="$path"
    unset SESSION
    run_config "$file" name "$path" 2>/dev/null \
      | head -n 1 \
      | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
  ) || return 1

  [ -n "$name" ] || return 1

  sanitize_session_name "$name"
}

report_name_collision() {
  # Explains a session name collision on stderr: the name that was derived, the
  # directory it was derived for, and the directory the session already holding
  # that name was started at. Three facts, because any one of them alone leaves
  # the obvious question unanswered.
  #
  # stderr rather than stdout because every caller of this runs inside a command
  # substitution whose stdout is the session name.
  #
  # Args:
  #   $1: name: the derived session name
  #   $2: path: the directory a session is being created for
  #   $3: existing: the directory the session already called $1 was started at
  local name="$1" path="$2" existing="$3"
  local red reset
  red=$(tput setaf 1) reset=$(tput sgr0)

  {
    printf '%sSession name collision%s\n' "$red" "$reset"
    printf '  %-18s%s\n' 'name' "$name"
    printf '  %-18s%s\n' 'new session at' "$path"
    printf '  %-18s%s\n' "'$name' is open at" "${existing:-(unknown)}"
  } >&2
}

session_name_prompt() {
  # Prompts for a session name, offering $2 as the default. Echoes the name.
  #
  # The suggestion is passed in rather than derived here because the two callers
  # arrive with different ones: `-p` offers whatever the naming rules produced,
  # and the collision path offers the name that just turned out to be taken.
  #
  # Args:
  #   $1: path: the directory the session will be created at
  #   $2: session_name: the name to offer as the default
  #   $3: quiet: optional; any value suppresses the path header, for a caller
  #       that has already shown the path itself
  local path="$1"
  local session_name="$2"
  local quiet="$3"

  [ -n "$quiet" ] || printf "%s\n" "$(tput setaf 8)$path$(tput sgr0)" >&2
  while true; do
    local prompt="Enter session name"
    if ! tmux has-session -t "=$session_name" 2>/dev/null; then
      prompt="$prompt [$(tput setaf 4)${session_name}$(tput sgr0)]"
    fi
    # A read that cannot be answered ends this rather than asking again: the
    # session a name was asked for may be started from tmux's run-shell, where
    # there is no terminal to answer with, and an unanswerable prompt in a
    # loop is a hang.
    if ! read -rp "$prompt: " user_input; then
      printf "\n" >&2
      notify "Error: no terminal to read a session name from"
      return 1
    fi

    local candidate="${user_input:-$session_name}"

    # tmux target syntax is session:window.pane, so a name holding either
    # separator can be created and then never referred to again. tsm cannot
    # switch to or kill it, and neither can tmux. `/` is fine and is not
    # rejected: a worktree session is named repo/worktree. Rejected rather than
    # rewritten: the name the user typed is not tsm's to change.
    case "$candidate" in
      *[:.]*)
        printf "$(tput setaf 1)Session names cannot contain ':' or '.'$(tput sgr0)\n" >&2
        continue
        ;;
    esac

    session_name="$candidate"
    if ! tmux has-session -t "=$session_name" 2>/dev/null; then
      break
    fi
    printf "$(tput setaf 1)Session '%s' already exists.$(tput sgr0)\n" "$session_name" >&2
  done
  echo "$session_name"
}

check_bookmark_char() {
  # Exits unless the argument can key a bookmark: a single printable ASCII
  # character, the same range vim marks accept. One character is the whole
  # point. A bookmark is meant to be recalled from memory, and anything
  # longer would be a name rather than a mark.
  #
  # Checked by code point rather than against a pattern like [!-~]: outside the
  # C locale a range is read in collation order, and the letters that matter
  # most as bookmarks fall outside it there.
  #
  # Args:
  #   $1: char: the character to check
  local char="$1" code

  if [ "${#char}" -eq 1 ]; then
    code=$(printf '%d' "'$char" 2>/dev/null)
    if [ -n "$code" ] && [ "$code" -ge 33 ] && [ "$code" -le 126 ]; then
      return 0
    fi
  fi

  notify "Error: a bookmark is keyed by a single printable character"
  exit 1
}

prompt_bookmark_char() {
  # Asks for a bookmark character: a single keypress, the way vim's m{char}
  # takes the character that follows it.
  #
  # Inside tmux the asking is tmux's own. command-prompt -1 puts the prompt in
  # the status line and takes the next key, which is why no popup is needed to
  # bind any of this to a key. It does not answer back, though: it runs a
  # command of its own once the key is pressed. So tsm runs again with the
  # character rather than this call returning it, and the template says how --
  # the tsm arguments to run, with {} standing in for the character.
  #
  # Outside tmux there is no status line to ask in, so the character is read
  # from the terminal and left in PROMPTED_BOOKMARK_CHAR.
  #
  # Returns non-zero when there is nothing left for the caller to do: tmux has
  # been asked, or the prompt was backed out of.
  #
  # Args:
  #   $1: prompt: what to ask for, without trailing punctuation
  #   $@: the tsm arguments to run once the character is known, with {} where
  #       the character goes
  local prompt="$1"
  shift

  if [ -n "$TMUX" ]; then
    # The character is quoted for the shell run-shell hands the command to.
    # Single quotes, because tmux's %%% escapes the quotation marks a keypress
    # can produce and a shell reads nothing else inside them -- a backslash, a
    # dollar sign or a semicolon typed at the prompt is just a character.
    local cmd arg
    cmd="$(printf '%q' "$(tsm_self)") _bookmark-prompted '%%%'"
    for arg in "$@"; do
      cmd="$cmd $(printf '%q' "$arg")"
    done

    tmux command-prompt -1 -p "$prompt:" "run-shell -b \"$(tmux_command_string "$cmd")\""
    return 1
  fi

  local char

  # Braces, so that the 2>/dev/null lasts only as long as the redirection it
  # is quieting. On the exec itself it would silence this shell's stderr for
  # good, prompt included.
  if ! { exec 3< /dev/tty; } 2>/dev/null; then
    notify "Error: no terminal to read a bookmark character from"
    exit 1
  fi

  printf '%s: ' "$prompt" >&2
  IFS= read -rsn 1 char <&3
  exec 3<&-

  # Enter and escape back out of the prompt.
  case "$char" in
    '' | $'\e')
      printf '\n' >&2
      return 1
      ;;
  esac

  # Echoed back, since the keypress itself was read silently.
  printf '%s\n' "$char" >&2

  PROMPTED_BOOKMARK_CHAR="$char"
}

read_bookmarks() {
  # Emits one "char<TAB>directory" line per bookmark, sorted by character.
  #
  # Bookmarks are stored as a flat JSON object of character -> directory, the
  # shape buf-mark writes its marks in. It is parsed here rather than with jq
  # so that bookmarks cost nothing beyond the fzf tsm already needs: the file
  # holds nothing but strings, and the only escapes it can hold are the ones
  # write_bookmarks produces.
  #
  # A pair whose key is not a single character, or whose value is empty or
  # holds a tab or a newline, is dropped. tsm cannot write one, and letting one
  # through would split a line that callers read whole.
  [ -f "$BOOKMARKS_FILE" ] || return 0

  awk '
    { json = json $0 "\n" }

    # Decodes the JSON string starting at i (its opening quote), leaving i on
    # the character after its closing quote.
    function read_string(   out, c, e) {
      out = ""
      i++
      while (i <= n) {
        c = substr(json, i, 1)
        if (c == "\"") { i++; break }
        if (c == "\\") {
          e = substr(json, i + 1, 1)
          if (e == "n") c = "\n"
          else if (e == "t") c = "\t"
          else if (e == "r") c = "\r"
          else if (e == "b") c = "\b"
          else if (e == "f") c = "\f"
          else c = e
          i++
        }
        out = out c
        i++
      }
      return out
    }

    END {
      n = length(json)
      i = 1

      # The object is flat, so its strings alternate key, value.
      while (i <= n) {
        if (substr(json, i, 1) != "\"") { i++; continue }
        key = read_string()

        # Whatever separates a key from its value -- the colon, and whatever
        # whitespace surrounds it -- belongs to neither string.
        while (i <= n && substr(json, i, 1) != "\"") i++
        if (i > n) break
        val = read_string()

        if (length(key) == 1 && val != "" && val !~ /[\t\n]/) print key "\t" val
      }
    }
  ' "$BOOKMARKS_FILE" | LC_ALL=C sort
}

write_bookmarks() {
  # Reads "char<TAB>directory" lines on stdin and replaces the store with them.
  # Written to a temporary file and moved into place, so an interrupted write
  # leaves the bookmarks that were already there rather than half a file.
  local tmp="$BOOKMARKS_FILE.tmp"

  awk -F'\t' '
    # Walked a character at a time rather than with gsub, whose replacement
    # text has escaping rules of its own: doubling a backslash there means
    # spelling one out four times over.
    function escape(s,   out, i, c) {
      out = ""
      for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (c == "\"" || c == "\\") out = out "\\"
        out = out c
      }
      return out
    }

    BEGIN { printf "{\n" }
    NF >= 2 { printf "%s  \"%s\": \"%s\"", (count++ ? ",\n" : ""), escape($1), escape($2) }
    END { printf "%s}\n", (count ? "\n" : "") }
  ' > "$tmp" && mv "$tmp" "$BOOKMARKS_FILE"
}

bookmark_directory() {
  # Echoes the directory bookmarked at a character. Returns non-zero, and
  # echoes nothing, when the character has no bookmark.
  #
  # Args:
  #   $1: char: the bookmark character to look up
  local char="$1" c dir

  while IFS=$'\t' read -r c dir; do
    if [ "$c" = "$char" ]; then
      echo "$dir"
      return 0
    fi
  done < <(read_bookmarks)

  return 1
}

without_bookmark() {
  # Filters "char<TAB>directory" lines on stdin, dropping the bookmark keyed by
  # the given character. This is how a bookmark is removed or replaced: the
  # store is rewritten whole rather than edited in place.
  #
  # The character is passed through the environment rather than with -v, which
  # would read a backslash in it as the start of an escape sequence.
  #
  # Args:
  #   $1: char: the bookmark character to drop
  TSM_BOOKMARK_CHAR="$1" awk -F'\t' '
    BEGIN { char = ENVIRON["TSM_BOOKMARK_CHAR"] }
    $1 != char
  '
}

bookmark_entries() {
  # Emits the bookmark picker's rows: the character and the directory, tab
  # separated, followed by the "char directory" column that is displayed. fzf
  # is pointed at that third field with --with-nth, so the first two ride along
  # for its bindings to use without ever being shown.
  local char dir

  while IFS=$'\t' read -r char dir; do
    printf '%s\t%s\t%s    %s\n' "$char" "$dir" "$char" "${dir/#"$HOME"/\~}"
  done < <(read_bookmarks)
}

#################
# api functions #
#################
active_session() {
  local session="$1"

  # If no session provided, use fzf to select from active sessions
  if [ -z "$session" ]; then
    local active_sessions
    active_sessions=$(get_active_sessions)

    if [ -z "$active_sessions" ]; then
      notify "No active sessions"
      exit 1
    fi

    session=$(echo "$active_sessions" | fzf --cycle --prompt "Session > ")

    if [ -z "$session" ]; then
      exit 0
    fi
  fi

  if ! tmux has-session -t "=$session" 2>/dev/null; then
    notify "Error: Session '$session' is not running"
    exit 1
  fi

  switch_or_attach "$session"
}

last_session() {
  # Switches to the most recently visited session that is still open.
  # What `tmux switch-client -l` gets at, but robust to the previous
  # session having been closed since. record_switch builds HISTORY_FILE up
  # as sessions are left, oldest first, and prune_history keeps only the
  # ones still running, so it is walked newest first here to find the first
  # that is not the session already being looked at.
  if [ ! -f "$HISTORY_FILE" ]; then
    notify "No session history yet -- see README for the tmux.conf hook 'tsm last' needs"
    exit 1
  fi

  # Validated again on the way in: the file is only written when a switch
  # happens, so sessions closed since the last one are still in it here.
  prune_history

  local current=""
  [ -n "$TMUX" ] && current=$(tmux display-message -p '#S' 2>/dev/null)

  # Every line left in the file names a session that was running as of the prune
  # above, so the newest one that is not the current session is the target.
  local target=""
  while IFS= read -r session; do
    if [ "$session" != "$current" ]; then
      target="$session"
      break
    fi
  done < <(tac "$HISTORY_FILE" 2>/dev/null || tail -r "$HISTORY_FILE" 2>/dev/null)

  if [ -z "$target" ]; then
    notify "No previous session still open"
    exit 1
  fi

  switch_or_attach "$target"
}

kill_session() {
  local session="$1"

  # If no session provided, use fzf to select from active sessions
  if [ -z "$session" ]; then
    local active_sessions
    active_sessions=$(get_active_sessions)

    if [ -z "$active_sessions" ]; then
      notify "No active sessions to kill"
      exit 1
    fi

    session=$(echo "$active_sessions" | fzf --cycle --prompt "Kill Session > ")

    if [ -z "$session" ]; then
      exit 0
    fi
  fi

  if ! tmux has-session -t "=$session" 2>/dev/null; then
    notify "Error: Session '$session' is not running"
    exit 1
  fi

  local log_dir="$LOG_DIR/$session"
  local log_file="$log_dir/tsm.log"
  mkdir -p "$log_dir"

  # The configuration that built the session is read back from the marker
  # rather than resolved again, so the session is torn down by the one that
  # built it even if the patterns have since been edited to claim its directory
  # differently. A session created with -c recorded no marker and gets no
  # cleanup: running a teardown for a layout it never got is worse than not
  # running one at all.
  local matching_config
  matching_config=$(tmux show-environment -t "=$session" TSM_MATCHING_CONFIG 2>/dev/null | sed 's/^TSM_MATCHING_CONFIG=//')

  local session_file=""
  if [ -n "$matching_config" ]; then
    session_file=$(config_file_for_name "$matching_config") || session_file=""
  fi

  # Run the kill hook in the background, so the session goes away immediately
  # rather than waiting on cleanup. tsm kills the session itself either way.
  # `kill` is for everything around it, and a configuration that has no
  # teardown to do simply exits zero.
  if [ -n "$session_file" ]; then
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Killing session '$session'" > "$log_file"

    # ROOT comes from @tsm_path, the directory the session was created at, so
    # that `kill` sees the ROOT that `start` saw. A configuration claims a set
    # of directories and does not carry the particular one it was applied at.
    local session_root
    session_root=$(path_for_session "$session")

    # TSM_CONFIG_FILE goes along for the same reason it does on the way in:
    # without it a configuration calling `tsm kill-matching-config` resumes the
    # search from the top, matches itself, and runs its own teardown a second
    # time.
    nohup env SESSION="$session" ROOT="${session_root:-$HOME}" \
      TSM_CONFIG_FILE="$session_file" \
      "$session_file" kill >> "$log_file" 2>&1 &
  fi

  tmux kill-session -t "=$session"
}

matching_config_file() {
  # Echoes the path of the configuration claiming $ROOT, for the two commands a
  # configuration uses to opt into one. Both run inside a hook, so ROOT is
  # already exported; it is resolved here the way the pickers resolve the
  # directory they hand to matching_config_for_root, so a $ROOT written with a
  # symlink or a `..` is tested as the same path either way.
  #
  # The search resumes after $TSM_CONFIG_FILE, the configuration currently
  # running, which tsm exports alongside SESSION and ROOT. That is what makes
  # `tsm apply-matching-config` mean "the next configuration that also claims
  # this directory" rather than "me".
  if [ -z "$ROOT" ]; then
    notify "Error: ROOT is not set. Run this inside a configuration's start or kill"
    exit 1
  fi

  local resolved
  resolved=$(cd "$ROOT" 2>/dev/null && pwd -P) || resolved="$ROOT"

  matching_config_for_root "$resolved" "$TSM_CONFIG_FILE"
}

apply_matching_config() {
  # Runs the start hook of the next configuration whose `pattern` matches $ROOT
  # -- the layout the directory would have got had this configuration not
  # claimed it first. It is how a configuration reuses the setup its neighbours
  # share instead of repeating it, at the point it calls
  # `tsm apply-matching-config`.
  #
  # No configuration matching is not an error. It is the same answer a picked
  # directory would get: nothing is applied. Saying so on stdout puts it in the
  # session log, where a `pattern` that was meant to match can be seen not to
  # have.
  local file
  file=$(matching_config_file) || {
    echo "No further configuration matches ROOT '$ROOT'; nothing to apply"
    return
  }

  # SESSION and ROOT are already exported: this runs inside a hook, which tsm
  # gave them to, so the configuration reached this way sees the same
  # environment it would have seen claiming the directory itself. TSM_CONFIG_FILE
  # is the exception and moves on, so that a configuration reached this way can
  # fall through to the next one in turn rather than back to itself.
  TSM_CONFIG_FILE="$file" run_config "$file" start
}

kill_matching_config() {
  # The counterpart of apply_matching_config: runs the kill hook of the next
  # configuration matching $ROOT. A configuration that opted into the shared
  # layout by calling `tsm apply-matching-config` in start opts into its
  # cleanup by calling `tsm kill-matching-config` in kill. Sessions no
  # configuration claimed at all run neither.
  local file
  file=$(matching_config_file) || {
    echo "No further configuration matches ROOT '$ROOT'; nothing to clean up"
    return
  }

  TSM_CONFIG_FILE="$file" run_config "$file" kill
}

dir_session() {
  local target_dir="" no_config="" prompt_name=""
  expand_short_flags "$@"
  for arg in "${EXPANDED_ARGS[@]}"; do
    case "$arg" in
      -c | --no-config) no_config=1 ;;
      -p | --prompt-name) prompt_name=1 ;;
      -*)
        notify "Error: Unknown option '$arg' for 'tsm dir'"
        exit 1
        ;;
      *) target_dir="$arg" ;;
    esac
  done

  local selected

  if [ -n "$target_dir" ]; then
    # Path provided, use it directly
    # Expand tilde if present
    selected="${target_dir/#\~/$HOME}"

    if [ ! -d "$selected" ]; then
      notify "Error: Directory '$selected' does not exist"
      exit 1
    fi
  else
    # No path provided, use fzf to select from TSM_DIRS_CMD or default
    local dirs_cmd="${TSM_DIRS_CMD:-$TSM_DIRS_CMD_DEFAULT}"

    # Use process substitution to allow killing the directory generator after fzf exits
    exec 3< <(eval "$dirs_cmd")
    local dirs_pid=$!
    selected=$(fzf --cycle --prompt "Directory > " <&3)
    kill "$dirs_pid" 2>/dev/null
    wait "$dirs_pid" 2>/dev/null
    exec 3<&-

    if [ -z "$selected" ]; then
      exit 0
    fi
  fi

  # Resolve to absolute path
  selected=$(cd "$selected" && pwd -P)

  # A session is identified by the directory it was started at, not by its
  # name. Picking a directory that already has a session open returns to it,
  # whatever it has since been renamed to, and before any naming happens at
  # all: there is nothing to name when nothing is being created, so this is
  # also the answer -p gets.
  local existing
  if existing=$(session_for_path "$selected"); then
    switch_or_attach "$existing"
    exit 0
  fi

  # A configuration may claim the path with its `pattern`. It gets to name the
  # session, with the `name` verb, and to build it, with `start`. -c opts out of
  # both: it is how you ask for a bare session at a path some configuration
  # would otherwise have opinions about.
  local matching_file="" matching_config=""
  if [ -z "$no_config" ]; then
    if matching_file=$(matching_config_for_root "$selected"); then
      matching_config=$(config_name_for_file "$matching_file")
    else
      matching_file=""
    fi
  fi

  # The name the rules produce: the configuration's, if it has an opinion, and
  # the directory's otherwise.
  local session_name=""
  [ -n "$matching_file" ] && session_name=$(config_session_name "$matching_file" "$selected")
  [ -n "$session_name" ] || session_name=$(default_session_name "$selected")

  if [ -n "$prompt_name" ]; then
    # -p is the last word on the name. The rules still get to make the
    # suggestion -- seeing what a configuration would have called this and
    # pressing enter is most of what -p is used for -- but anything typed over
    # it wins.
    #
    # Failing inside a command substitution is why session_name_prompt returns
    # rather than exits: an exit there would only end the subshell and leave
    # this to carry on with an empty name.
    session_name=$(session_name_prompt "$selected" "$session_name") || exit 1
  else
    # The path is not open -- that was settled above -- so a session already
    # holding this name is a genuine collision: two directories whose names
    # landed on the same string. Switching there would silently take you
    # somewhere you did not pick, so say what collided with what and let the
    # name be given by hand.
    if tmux has-session -t "=$session_name" 2>/dev/null; then
      local taken="$session_name" existing_path
      existing_path=$(path_for_session "$taken")
      report_name_collision "$taken" "$selected" "$existing_path"

      # The report has already put the path on stderr, so the prompt does not
      # repeat it.
      session_name=$(session_name_prompt "$selected" "$taken" quiet) || {
        # session_name_prompt has already said there was no terminal to answer
        # with, but that goes to stderr, and a session started from tmux's
        # run-shell has nowhere for stderr to land. Say the whole thing once
        # more through notify, which becomes a tmux message there.
        notify "Error: session '$taken' is already open at ${existing_path:-an unknown path}; $selected needs a name of its own"
        exit 1
      }
    fi
  fi

  local width height
  read -r width height < <(client_size)

  # Sized up front, whether or not a configuration is involved: tmux creates a
  # detached session at 80x24, so a percentage split made before the client
  # attaches is computed against 80 columns and drifts toward 50/50 once the
  # real size arrives.
  tmux new-session -d -s "$session_name" -c "$selected" ${width:+-x "$width"} ${height:+-y "$height"} || exit 1

  # The directory the session was created at, recorded on the session itself.
  # Everything that has to know what a session is reads this: the check at the
  # top of this function, the collision report, and the ROOT kill_session hands
  # the teardown hook.
  #
  # The trailing `:` is load-bearing. `set-option` takes a target *pane*, not a
  # target session, and infers the option's scope from its name -- a user option
  # lands on the session the pane belongs to. `=name` alone is read as a pane
  # target and fails to resolve; `=name:` is that session's current pane, which
  # is the session tsm just made.
  tmux set-option -t "=$session_name:" @tsm_path "$selected"

  if [ -n "$matching_file" ]; then
    # Logged the way any script tsm runs is: its output is the only thing to go
    # on when it misbehaves. A session no configuration claimed runs no script,
    # so it gets no log.
    local log_dir="$LOG_DIR/$session_name"
    local log_file="$log_dir/tsm.log"
    mkdir -p "$log_dir"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting session '$session_name'" > "$log_file"

    # Run in a subshell so that a configuration aborting under its own `set -e`
    # does not tear down a session that tmux already created. The marker is
    # recorded inside it for the same reason: it is only true once the
    # configuration has actually been applied.
    #
    # kill_session reads it to know which file this session's cleanup belongs
    # to. A session created with -c records nothing: cleaning up a layout it
    # never got is worse than not cleaning up at all.
    (
      export SESSION="$session_name" ROOT="$selected" TSM_CONFIG_FILE="$matching_file"
      run_config "$matching_file" start
      tmux set-environment -t "=$session_name" TSM_MATCHING_CONFIG "$matching_config"
    ) >> "$log_file" 2>&1
  fi

  switch_or_attach "$session_name"
}

git_session() {
  local brief="" fetch="" no_config="" prompt_name=""
  expand_short_flags "$@"
  for arg in "${EXPANDED_ARGS[@]}"; do
    case "$arg" in
      -b | --brief) brief=1 ;;
      -c | --no-config) no_config=1 ;;
      -f | --fetch) fetch=1 ;;
      -p | --prompt-name) prompt_name=1 ;;
      *)
        notify "Error: Unknown option '$arg' for 'tsm git'"
        exit 1
        ;;
    esac
  done
  # Fetching only exists to freshen the ahead/behind counts in the brief, so
  # asking for it is enough to ask for the brief itself.
  [ -n "$fetch" ] && brief=1
  local git_dirs_cmd="${TSM_GIT_DIRS_CMD:-$TSM_GIT_DIRS_CMD_DEFAULT}"

  local dirs selected
  dirs=$(eval "$git_dirs_cmd" | sort)

  if [ -z "$dirs" ]; then
    notify "No git repositories found"
    exit 1
  fi

  if [ -z "$brief" ]; then
    selected=$(echo "$dirs" | fzf --cycle --prompt "Repo > ")
  else
    if [ -n "$fetch" ]; then
      # Fetch in parallel, but bounded. Backgrounding one `git fetch` per repo
      # and then waiting forks the whole list at once. Each fetch forks an
      # ssh or git-remote-https child of its own. A machine with a few
      # hundred repos under $HOME opens that many remote connections at once
      # and can run into the process limit. xargs keeps a fixed number in
      # flight instead. NUL separation so repo paths with spaces survive.
      printf '%s\n' "$dirs" | tr '\n' '\0' \
        | xargs -0 -P "${TSM_GIT_FETCH_JOBS:-8}" -n 1 \
                sh -c 'git -C "$1" fetch --quiet 2>/dev/null' _
    fi

    selected=$(echo "$dirs" \
      | while read -r dir; do
          printf '%s\t%s  %s\n' "$dir" "$dir" "$(git_brief "$dir" --no-fetch)"
        done \
      | fzf --ansi --cycle --delimiter=$'\t' --with-nth=2 --prompt "Repo > ")
    selected="${selected%%	*}"
  fi

  if [ -z "$selected" ]; then
    exit 0
  fi

  dir_session "$selected" ${no_config:+--no-config} ${prompt_name:+--prompt-name}
}

worktree_session() {
  local name="" no_config="" prompt_name=""
  expand_short_flags "$@"
  for arg in "${EXPANDED_ARGS[@]}"; do
    case "$arg" in
      -c | --no-config) no_config=1 ;;
      -p | --prompt-name) prompt_name=1 ;;
      -*)
        notify "Error: Unknown option '$arg' for 'tsm worktree'"
        exit 1
        ;;
      *) name="$arg" ;;
    esac
  done

  local worktree_data
  worktree_data=$(git worktree list --porcelain | awk '
    /^worktree / { path = substr($0, 10); branch = "" }
    /^branch / { branch = substr($0, 8); sub("refs/heads/", "", branch) }
    /^bare$/ { path = "" }
    /^$/ { if (path != "") print path "\t" (branch != "" ? branch : "(detached)"); path = ""; branch = "" }
    END { if (path != "") print path "\t" (branch != "" ? branch : "(detached)") }
  ')

  if [ -z "$worktree_data" ]; then
    notify "No worktrees found"
    exit 0
  fi

  local selected
  if [ -n "$name" ]; then
    selected=$(echo "$worktree_data" | while IFS=$'\t' read -r wt _; do
      if [ "${wt##*/}" = "$name" ]; then
        echo "$wt"
        break
      fi
    done)

    if [ -z "$selected" ]; then
      notify "No worktree found matching '$name'"
      exit 1
    fi
  else
    # The header labels are measured alongside the values, so a column of
    # short worktree names still widens to fit `wt` rather than the label
    # overhanging it. fzf indents --header by the two columns its pointer
    # takes on the rows below, so the two line up with no padding of our own.
    local name_label='wt' branch_label='branch'
    local fzf_input header max_name=${#name_label} max_branch=${#branch_label}
    while IFS=$'\t' read -r wt branch; do
      local wt_name="${wt##*/}"
      (( ${#wt_name} > max_name )) && max_name=${#wt_name}
      (( ${#branch} > max_branch )) && max_branch=${#branch}
    done <<< "$worktree_data"
    fzf_input=$(echo "$worktree_data" | while IFS=$'\t' read -r wt branch; do
      printf '%s\t%-*s  \033[32m%-*s\033[0m  %s\n' "$wt" "$max_name" "${wt##*/}" "$max_branch" "$branch" "$wt"
    done)
    header=$(printf '%-*s  %-*s  %s' "$max_name" "$name_label" "$max_branch" "$branch_label" 'path')

    selected=$(echo "$fzf_input" | fzf --ansi --cycle --with-nth=2 --delimiter=$'\t' --prompt "Worktree > " --header "$header")

    if [ -z "$selected" ]; then
      exit 0
    fi

    selected="${selected%%	*}"
  fi

  dir_session "$selected" ${no_config:+--no-config} ${prompt_name:+--prompt-name}
}

bookmark_prompted() {
  # Internal: the command tmux's status line prompt runs once its key is
  # pressed. The key comes first, and the tsm command to run follows it, with
  # {} where the character goes.
  #
  # Args:
  #   $1: char: the key the prompt was answered with
  #   $@: the tsm arguments to run, with {} standing in for the character
  local char="$1"
  shift

  # Enter and escape back out of the prompt. tmux hands them over as ordinary
  # characters, so this is where they stop.
  case "$char" in
    '' | $'\e' | $'\r') exit 0 ;;
  esac

  local args=() arg
  for arg in "$@"; do
    [ "$arg" = '{}' ] && arg="$char"
    args+=("$arg")
  done

  exec "$0" "${args[@]}"
}

bookmark_add() {
  # Bookmarks a directory at a character, replacing whatever that character
  # was bookmarking before -- the way setting a vim mark that is already set
  # replaces it. The directory defaults to the current one, which is what makes
  # `tsm bookmark-add p` worth typing from inside a project.
  #
  # Args:
  #   $1: char: the bookmark character (prompted for when empty)
  #   $2: path: directory to bookmark (default: the current directory)
  local char="$1" path="${2:-$PWD}"

  path="${path/#\~/$HOME}"

  if [ ! -d "$path" ]; then
    notify "Error: Directory '$path' does not exist"
    exit 1
  fi

  path=$(cd "$path" && pwd -P)

  if [ -z "$path" ]; then
    notify "Error: Directory '${2:-$PWD}' could not be resolved"
    exit 1
  fi

  # Rejected rather than escaped: a control character in the path would have to
  # survive being written as JSON, read back as a whole line, and printed as a
  # column of the picker, and no directory worth bookmarking has one.
  case "$path" in
    *[[:cntrl:]]*)
      notify "Error: '$path' cannot be bookmarked: its path contains a control character"
      exit 1
      ;;
  esac

  # No character given: ask for one. The directory is named in the prompt,
  # since a key binding is the way this is usually reached and nothing else on
  # screen says what is about to be bookmarked.
  if [ -z "$char" ]; then
    prompt_bookmark_char "Bookmark ${path/#"$HOME"/\~} as" bookmark-add '{}' "$path" || exit 0
    char="$PROMPTED_BOOKMARK_CHAR"
  fi

  check_bookmark_char "$char"

  {
    read_bookmarks | without_bookmark "$char"
    printf '%s\t%s\n' "$char" "$path"
  } | LC_ALL=C sort | write_bookmarks

  # What the status line shows just changed, and no session was created or
  # killed for a hook to notice it.
  refresh_status

  notify "Bookmark set: $char -> $path"
}

bookmark_remove() {
  # Removes a bookmark.
  #
  # Args:
  #   $1: char: the bookmark character to remove (prompted for when empty)
  local char="$1"

  # No character given: ask for one. Nothing is listed alongside it -- the
  # prompt is a status line away from being unable to, and `tsm bookmark-list`
  # is there for when the character will not come to mind.
  if [ -z "$char" ]; then
    if [ -z "$(read_bookmarks)" ]; then
      notify "No bookmarks set"
      exit 1
    fi

    prompt_bookmark_char "Remove bookmark" bookmark-remove '{}' || exit 0
    char="$PROMPTED_BOOKMARK_CHAR"
  fi

  check_bookmark_char "$char"

  if ! bookmark_directory "$char" > /dev/null; then
    notify "Error: No bookmark '$char'"
    exit 1
  fi

  read_bookmarks | without_bookmark "$char" | write_bookmarks

  refresh_status

  notify "Bookmark removed: $char"
}

bookmark_list() {
  # Prints every bookmark as "char    directory". With -f, fzf does the showing
  # instead, and the bookmark picked starts a session.
  local use_fzf="" entries char dir
  expand_short_flags "$@"
  for arg in "${EXPANDED_ARGS[@]}"; do
    case "$arg" in
      -f | --fzf) use_fzf=1 ;;
      *)
        notify "Error: Unknown option '$arg' for 'tsm bookmark-list'"
        exit 1
        ;;
    esac
  done

  if [ -n "$use_fzf" ]; then
    bookmark_pick
    return
  fi

  entries=$(read_bookmarks)

  if [ -z "$entries" ]; then
    notify "No bookmarks set"
    exit 1
  fi

  while IFS=$'\t' read -r char dir; do
    printf '%s    %s\n' "$char" "${dir/#"$HOME"/\~}"
  done <<< "$entries"
}

bookmark_status() {
  # Prints the bookmark characters of the sessions that are open, for a tmux
  # status line: one character per bookmark whose directory a session is
  # currently rooted at, with the current session's styled differently.
  #
  # This is the compact alternative to reading session names off a status
  # line. Only bookmarks are shown, and only the ones you could switch to
  # right now, so the line stays short enough to take in at a glance.
  #
  # Nothing is printed when no open session is bookmarked, and nothing is ever
  # notified: this runs on every status line redraw, so anything it has to say
  # would be said over and over.
  #
  # Args:
  #   $1: path: the directory of the session to treat as the current one
  #       (default: the session tmux reports as current)
  #   -s, --style: tmux style for the other sessions' characters
  #   -c, --current-style: tmux style for the current session's character
  local style="dim" current_style="fg=yellow,bold" current="" current_given=""

  # Styles are given without their #[] wrapper, so that a status line format
  # holding one does not have to escape it.
  while [ $# -gt 0 ]; do
    case "$1" in
      -s | --style | -c | --current-style)
        if [ $# -lt 2 ]; then
          notify "Error: '$1' needs a tmux style"
          exit 1
        fi
        case "$1" in
          -s | --style) style="$2" ;;
          -c | --current-style) current_style="$2" ;;
        esac
        shift 2
        ;;
      -*)
        notify "Error: Unknown option '$1' for 'tsm bookmark-status'"
        exit 1
        ;;
      *)
        if [ -n "$current_given" ]; then
          notify "Error: Too many arguments for 'tsm bookmark-status'"
          exit 1
        fi
        current="$1"
        current_given=1
        shift
        ;;
    esac
  done

  local open
  open=$(tmux list-sessions -F '#{session_path}' 2>/dev/null)
  [ -n "$open" ] || return 0

  # A session is the current one by the directory it is rooted at, the same
  # thing a bookmark holds.
  #
  # Which session that is has to be given by whoever is drawing the status
  # line, because tmux runs a #() command without a client and shares its
  # output between them all: asking tmux here would answer for some other
  # client's session, and answer the same thing for every client. A status
  # line passes #{session_path}, which tmux expands per client and which makes
  # each client's line a job of its own. Asking is the fallback, for a shell
  # that has a session of its own to be current.
  if [ -z "$current_given" ] && [ -n "$TMUX" ]; then
    current=$(tmux display-message -p '#{session_path}' 2>/dev/null)
  fi

  # Each character is padded inside its own style, the way buf-mark's status
  # does it, so that a style with a background reads as a block rather than as
  # a tinted letter.
  #
  # Each style is preceded by a reset, because tmux styles accumulate: without
  # one, the attributes of the current session's character (its color, its
  # bold) stay on for every character drawn after it, and the current session
  # is no longer the one that stands out.
  read_bookmarks | TSM_OPEN_PATHS="$open" TSM_CURRENT_PATH="$current" \
    TSM_STYLE="$style" TSM_CURRENT_STYLE="$current_style" awk -F'\t' '
      BEGIN {
        n = split(ENVIRON["TSM_OPEN_PATHS"], paths, "\n")
        for (i = 1; i <= n; i++) if (paths[i] != "") open[paths[i]]
        current = ENVIRON["TSM_CURRENT_PATH"]
        style = ENVIRON["TSM_STYLE"]
        current_style = ENVIRON["TSM_CURRENT_STYLE"]
      }

      $2 in open {
        out = out "#[default]#[" (current != "" && $2 == current ? current_style : style) "] " $1 " "
      }

      END { if (out != "") print out "#[default]" }
    '
}

bookmark_goto() {
  # Starts a session at the directory a character is bookmarking. The session
  # itself is a directory session like any other, so a configuration rooted at
  # the bookmarked directory is what actually starts, and the flags the other
  # pickers take mean the same thing here.
  #
  # Args:
  #   $1: char: the bookmark character to jump to (prompted for when empty)
  #   $@: the remaining arguments are directory session flags, passed through
  local char="$1" dir
  shift

  # No character given: ask for one, the same keypress bookmark-add and
  # bookmark-remove take. Nothing is listed above it -- a bookmark is meant to
  # be recalled, and `tsm bookmark-list -f` is there for when it is not.
  if [ -z "$char" ]; then
    # Nothing to go to is worth saying outright, rather than asking for a
    # character that could not match anything.
    if [ -z "$(read_bookmarks)" ]; then
      notify "No bookmarks set"
      exit 1
    fi

    prompt_bookmark_char "Go to bookmark" bookmark "$@" '{}' || exit 0
    char="$PROMPTED_BOOKMARK_CHAR"
  fi

  check_bookmark_char "$char"

  if ! dir=$(bookmark_directory "$char"); then
    notify "Error: No bookmark '$char'"
    exit 1
  fi

  dir_session "$dir" "$@"
}

bookmark_pick() {
  # Browses the bookmarks with fzf and starts a session at the one picked.
  local entries
  entries=$(bookmark_entries)

  if [ -z "$entries" ]; then
    notify "No bookmarks set"
    exit 1
  fi

  # The bindings re-invoke tsm: ctrl-x removes the bookmark under the cursor,
  # then rebuilds the list from what is left on disk. fzf hands a binding to a
  # shell, so the path tsm was invoked by is quoted for one, and the character
  # is quoted by fzf itself when it fills in {1}.
  local self
  printf -v self '%q' "$(tsm_self)"

  local selected
  selected=$(printf '%s\n' "$entries" | fzf \
    --cycle \
    --delimiter=$'\t' \
    --with-nth=3 \
    --prompt "Bookmark > " \
    --header $':: \e[33mctrl-x\e[0m to \e[31mremove\e[0m' \
    --bind "ctrl-x:execute-silent($self bookmark-remove {1})+reload($self _bookmark-entries)")

  if [ -z "$selected" ]; then
    exit 0
  fi

  # The row carries the directory in its second field, so the session is rooted
  # at the bookmarked path rather than the ~ the picker displayed.
  local row="${selected#*$'\t'}"
  dir_session "${row%%$'\t'*}"
}

bookmark_session() {
  local char="" no_config="" prompt_name=""
  expand_short_flags "$@"
  for arg in "${EXPANDED_ARGS[@]}"; do
    case "$arg" in
      -c | --no-config) no_config=1 ;;
      -p | --prompt-name) prompt_name=1 ;;
      -*)
        notify "Error: Unknown option '$arg' for 'tsm bookmark'"
        exit 1
        ;;
      *) char="$arg" ;;
    esac
  done

  # A character goes straight to its session. Without one, bookmark_goto asks
  # for the character first.
  bookmark_goto "$char" ${no_config:+--no-config} ${prompt_name:+--prompt-name}
}

browse_logs() {
  local session="$1"

  local search_dir
  if [ -n "$session" ]; then
    search_dir="$LOG_DIR/$session"
    if [ ! -d "$search_dir" ]; then
      notify "Error: No log directory found for session '$session'"
      exit 1
    fi
  else
    search_dir="$LOG_DIR"
  fi

  local log_files
  log_files=$(find "$search_dir" -type f -name '*.log' 2>/dev/null | sed "s|^$LOG_DIR/||" | sort)

  if [ -z "$log_files" ]; then
    notify "No log files found"
    exit 1
  fi

  local selected
  selected=$(echo "$log_files" | fzf \
    --cycle \
    --bind=ctrl-d:preview-half-page-down \
    --bind=ctrl-u:preview-half-page-up \
    --bind="ctrl-o:execute(${EDITOR:-vi} '$LOG_DIR/{}')" \
    --prompt "Logs > " \
    --header $':: \e[33mEnter\e[0m to \e[31mtail\e[0m | \e[33mctrl-o\e[0m to \e[31mopen in editor\e[0m | \e[33mctrl-d\e[0m to \e[31mpreview page down\e[0m | \e[33mctrl-u\e[0m to \e[31mpreview page up\e[0m' \
    --preview "tail -n 100000 -f '$LOG_DIR/{}'" \
    --preview-window follow)

  if [ -z "$selected" ]; then
    exit 0
  fi

  tail -n 1000 -f "$LOG_DIR/$selected"
}

# Parse arguments
if [ $# -eq 0 ]; then
  usage
  exit 0
fi

command="$1"
shift

case "$command" in
  active)
    active_session "$1"
    ;;
  last)
    last_session
    ;;
  kill)
    kill_session "$1"
    ;;
  dir)
    dir_session "$@"
    ;;
  git)
    git_session "$@"
    ;;
  worktree)
    worktree_session "$@"
    ;;
  bookmark)
    bookmark_session "$@"
    ;;
  bookmark-add)
    bookmark_add "$1" "$2"
    ;;
  bookmark-remove)
    bookmark_remove "$1"
    ;;
  bookmark-list)
    bookmark_list "$@"
    ;;
  bookmark-status)
    bookmark_status "$@"
    ;;
  logs)
    browse_logs "$1"
    ;;
  apply-matching-config)
    apply_matching_config
    ;;
  kill-matching-config)
    kill_matching_config
    ;;
  _record-switch)
    # Internal: invoked by the client-session-changed hook registered in
    # the user's tmux.conf (see README). Not a user-facing command.
    record_switch "$1" "$2"
    ;;
  _refresh-status)
    # Internal: invoked by the session-created and session-closed hooks
    # registered in the user's tmux.conf (see README). Not a user-facing
    # command.
    refresh_status
    ;;
  _bookmark-prompted)
    # Internal: what tmux's status line prompt runs once its key is pressed.
    # Not a user-facing command.
    bookmark_prompted "$@"
    ;;
  _bookmark-entries)
    # Internal: rebuilds the bookmark picker's rows for its reload binding.
    # Not a user-facing command.
    bookmark_entries
    ;;
  help)
    usage
    ;;
  *)
    notify "Error: Unknown command '$command'"
    usage
    exit 1
    ;;
esac
