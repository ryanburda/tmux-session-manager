#!/bin/bash

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tsm"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/tsm"
LOG_DIR="$STATE_DIR/logs"
HISTORY_FILE="$STATE_DIR/session_history"
mkdir -p "$CONFIG_DIR" "$LOG_DIR"

TSM_DIRS_CMD_DEFAULT='find "$HOME" -maxdepth 4 -name ".*" -prune -o -type d \( -exec test -e {}/.git \; -print -prune -o -print \)'
TSM_GIT_DIRS_CMD_DEFAULT='find "$HOME" -maxdepth 4 -name ".*" -prune -o -type d -exec test -e {}/.git \; -print -prune 2>/dev/null'

tsm_source_dir() {
  # The directory tsm itself lives in, with any symlinks followed: tsm is
  # normally installed as a symlink on PATH, and the pickers it sources sit
  # beside the real file rather than beside the link.
  local src="$0" dir

  case "$src" in
    */*) ;;
    *) src=$(command -v -- "$src" 2>/dev/null) || src="$0" ;;
  esac

  while [ -L "$src" ]; do
    dir=$(cd -P "$(dirname -- "$src")" && pwd)
    src=$(readlink -- "$src")

    # A relative link is relative to the directory the link is in.
    case "$src" in
      /*) ;;
      *) src="$dir/$src" ;;
    esac
  done

  cd -P "$(dirname -- "$src")" && pwd
}

TSM_SOURCE_DIR=$(tsm_source_dir)

# The pickers live in a file of their own: they are the one part of tsm that
# is about choosing a directory rather than about the session that follows.
# shellcheck source=lib/pickers.sh
if ! . "$TSM_SOURCE_DIR/lib/pickers.sh"; then
  echo "tsm: could not read $TSM_SOURCE_DIR/lib/pickers.sh" >&2
  exit 1
fi

usage() {
  cat <<'EOF'
Tmux Session Manager

Usage
  tsm                                      # Show help message
  tsm active [session]                     # Switch to an existing session
  tsm kill [session]                       # Kill session (runs its kill hook if present)
  tsm last                                 # Switch to the most recent session that is still open

  tsm at <path> [-c] [-p]                  # Start a session at a directory, or switch to the
                                           # session already open there

  tsm via [-c] [-p] <program> [args]       # The same, at the directory <program> prints

    -c, --no-config                        # Ignore any configuration claiming the picked path
    -p, --prompt-name                      # Prompt for the session name instead of using the default

  tsm pick <picker>                        # Print the directory a built-in picker names

  tsm match [path]                         # Configurations claiming a path, best first (defaults to the current directory)
  tsm logs [session]                       # Browse session logs

  tsm help                                 # Show help message

Pickers
  A picker names a directory and nothing else: it takes none of the flags
  above, decides nothing about the session, and prints one path on stdout.
  Any program that does that is one, so `tsm via zoxide query -i` works, and
  so does a script of your own. These come with tsm, via `tsm pick <name>`:

  dir                                      # Any directory, with fzf
  git                                      # A git repository, with fzf
  git-brief                                # A git repository with something to show, with fzf
  worktree                                 # A worktree of this repository, with fzf

  tsm via tsm pick git                     # ...and that is how one becomes a session

See https://github.com/ryanburda/tmux-session-manager for more documentation
EOF
}

####################
# helper functions #
####################
notify() {
  # Show a message: tmux display-message inside tmux, stderr otherwise.
  # stderr because several callers run inside a command substitution whose
  # stdout is their return value.
  local msg="$1"
  if [ -n "$TMUX" ]; then
    tmux display-message "$msg"
  else
    echo "$msg" >&2
  fi
}

get_active_sessions() {
  # Active session names, one per line. Formatted rather than cut out of
  # `tmux ls`, which would split a name at its first colon.
  tmux list-sessions -F '#{session_name}' 2>/dev/null
}

prune_history() {
  # Drop sessions that are no longer running from HISTORY_FILE.
  [ -f "$HISTORY_FILE" ] || return 0

  local active
  active=$(get_active_sessions)

  # Whole-line keys, so a session name is never read as a pattern. Passed via
  # the environment: -v would expand backslashes in a name.
  TSM_ACTIVE="$active" awk '
    BEGIN {
      n = split(ENVIRON["TSM_ACTIVE"], names, "\n")
      for (i = 1; i <= n; i++) live[names[i]]
    }
    $0 in live
  ' "$HISTORY_FILE" > "$HISTORY_FILE.tmp" && mv "$HISTORY_FILE.tmp" "$HISTORY_FILE"
}

record_switch() {
  # Append the session being switched away from to HISTORY_FILE for `tsm last`.
  # Fired by the client-session-changed hook the user registers (see README).
  #
  # Args:
  #   $1: from: the session that was left
  #   $2: to: the session that was switched to
  local from="$1" to="$2"

  [ -n "$from" ] && [ "$from" != "$to" ] || return

  # Prune + dedupe on every write bounds the file at one line per running
  # session. -Fx matches the whole line literally, not as a regex.
  prune_history
  if [ -f "$HISTORY_FILE" ]; then
    grep -Fxv -- "$from" "$HISTORY_FILE" > "$HISTORY_FILE.tmp" 2>/dev/null
    mv "$HISTORY_FILE.tmp" "$HISTORY_FILE"
  fi

  echo "$from" >> "$HISTORY_FILE"
}

switch_or_attach() {
  # Switch to a session if inside tmux, attach otherwise.
  local session="$1"
  if [ -n "$TMUX" ]; then
    tmux switch-client -t "=$session"
  else
    tmux attach-session -t "=$session"
  fi
}

session_paths() {
  # Emit "<session name>\t<path>" for every running session. The path is the
  # @tsm_path recorded at creation; #{session_path} is the fallback for
  # sessions tsm did not create (it drifts as the first pane cds around,
  # which is why @tsm_path exists).
  tmux list-sessions -F $'#{session_name}\t#{@tsm_path}\t#{session_path}' 2>/dev/null \
    | while IFS=$'\t' read -r name recorded fallback; do
        printf '%s\t%s\n' "$name" "${recorded:-$fallback}"
      done
}

session_for_path() {
  # Echo the running session started at $1, or nothing with a non-zero status.
  # Compared in the shell: tmux's filter parser reads `,` and `}` in a path.
  local want="$1" name path
  while IFS=$'\t' read -r name path; do
    [ "$path" = "$want" ] || continue
    printf '%s\n' "$name"
    return 0
  done < <(session_paths)
  return 1
}

path_for_session() {
  # Echo the path the session named $1 was started at, or nothing with a
  # non-zero status.
  local want="$1" name path
  while IFS=$'\t' read -r name path; do
    [ "$name" = "$want" ] || continue
    printf '%s\n' "$path"
    return 0
  done < <(session_paths)
  return 1
}

sanitize_session_name() {
  # Replace every character outside [A-Za-z0-9_-/] with _. `/` survives for
  # repo/worktree names; `.` and `:` must not, being tmux target separators.
  # Takes a name, not a path: callers take the basename themselves.
  printf '%s' "$1" | tr -c 'a-zA-Z0-9_/-' '_'
}

client_size() {
  # Print "WIDTH HEIGHT" for the client that will attach, or nothing. tmux
  # creates detached sessions at 80x24, so percentage splits made before the
  # client attaches drift once the real size arrives; sizing up front avoids
  # that.
  local width height

  width=$(tmux display-message -p '#{client_width}' 2>/dev/null)
  height=$(tmux display-message -p '#{client_height}' 2>/dev/null)

  # Outside tmux, fall back to the terminal tsm was invoked from.
  if [ -z "$width" ] || [ -z "$height" ]; then
    read -r height width < <({ stty size < /dev/tty; } 2>/dev/null)
  fi

  case "$width$height" in
    *[!0-9]* | '') return 1 ;;
  esac

  # A pty with no size set answers `0 0`, which tmux refuses.
  [ "$width" -gt 0 ] && [ "$height" -gt 0 ] || return 1

  echo "$width $height"
}

expand_short_flags() {
  # Split clustered short flags (-cp -> -c -p) into EXPANDED_ARGS so the
  # subcommand parsers see one flag per argument. Everything else passes
  # through untouched.
  EXPANDED_ARGS=()
  local arg i
  for arg in "$@"; do
    case "$arg" in
      -[!-]*)
        for (( i = 1; i < ${#arg}; i++ )); do
          EXPANDED_ARGS+=("-${arg:i:1}")
        done
        ;;
      *) EXPANDED_ARGS+=("$arg") ;;
    esac
  done
}

default_session_name() {
  # Derive a session name for a directory: repo/worktree for a linked
  # worktree, the sanitized basename otherwise. Two worktrees whose paths end
  # in the same segment derive the same name; that is caught later as a name
  # collision, since a session is identified by its path.
  #
  # Args:
  #   $1: path: directory to derive the session name from
  local path="$1"

  local git_dir
  git_dir=$(git -C "$path" rev-parse --absolute-git-dir 2>/dev/null)

  # A linked worktree's git dir is <common dir>/worktrees/<name> and holds a
  # gitdir file. Both are tested: inside a subdirectory of an ordinary repo,
  # rev-parse also answers absolutely.
  if [ -n "$git_dir" ] && [ -f "$git_dir/gitdir" ] &&
    [ "$(basename "$(dirname "$git_dir")")" = "worktrees" ]; then
    local repo_dir
    repo_dir=$(dirname "$(dirname "$git_dir")")
    local repo_leaf
    repo_leaf=$(basename "$repo_dir")

    # Step over conventional bare-repo wrappers: worktrees of
    # ~/code/api/.bare belong to `api`, not `.bare`.
    local repo_name
    if [ "$repo_leaf" = ".bare" ] || [ "$repo_leaf" = ".git" ]; then
      repo_name=$(basename "$(dirname "$repo_dir")")
    else
      repo_name="$repo_leaf"
    fi

    # Sanitized separately, so the joining `/` is the only one: a worktree
    # directory named v1.2 would otherwise put a `.` in the name.
    echo "$(sanitize_session_name "$repo_name")/$(sanitize_session_name "$(basename "$path")")"
  else
    sanitize_session_name "$(basename "$path")"
  fi
}

config_files() {
  # Paths of the configuration files under $CONFIG_DIR, one per line.
  # A configuration is an executable program; tsm runs it with a verb and
  # reads its answer.
  #
  # -L: configurations are commonly symlinks. -perm -u+x: -executable is
  # GNU-only. LC_ALL=C sort: tie-breaking must not depend on the locale.
  [ -d "$CONFIG_DIR" ] || return

  find -L "$CONFIG_DIR" -type f -perm -u+x 2>/dev/null | LC_ALL=C sort
}

config_name_for_file() {
  # Echo the configuration name for a file: its path under $CONFIG_DIR minus
  # any final extension, so `work`, `work.sh` and `work.fish` are all `work`.
  # A leading dot is not an extension: `.work.fish` is `.work`.
  #
  # Args:
  #   $1: file: path to a configuration file under $CONFIG_DIR
  local rel base dir="" dot=""
  rel="${1#"$CONFIG_DIR/"}"

  base="${rel##*/}"
  [ "$base" = "$rel" ] || dir="${rel%/*}/"

  case "$base" in .*) dot="."; base="${base#.}" ;; esac
  case "$base" in *.*) base="${base%.*}" ;; esac

  printf '%s%s%s\n' "$dir" "$dot" "$base"
}

config_file_for_name() {
  # Echo the path of the configuration named $1, or nothing with a non-zero
  # status. A search, since the extension is not knowable from the name;
  # first match in LC_ALL=C order wins.
  #
  # Args:
  #   $1: name: a configuration name, as config_name_for_file produces
  local want="$1" file
  while IFS= read -r file; do
    if [ "$(config_name_for_file "$file")" = "$want" ]; then
      printf '%s\n' "$file"
      return 0
    fi
  done < <(config_files)
  return 1
}

run_config() {
  # Run a configuration with a verb: pattern, name, start or kill. The
  # contract is argv in, stdout and exit status out; tsm never looks inside
  # the file. A verb the program does not handle must exit 0. Only `pattern`
  # and `name` treat stdout as an answer; for `start` and `kill` it is the
  # session log, and callers redirect it there.
  #
  # set -m gives background jobs their own process group; the subshell keeps
  # a configuration that exits from taking tsm with it.
  #
  # Args:
  #   $1: file: path to the configuration
  #   $2: verb: one of pattern, name, start, kill
  #   $@: any further arguments the verb takes
  local file="$1" verb="$2"
  shift 2
  ( set -m; exec "$file" "$verb" "$@" )
}

rank_configs_for_root() {
  # Emit "<score>\t<file>" for every configuration whose pattern claims the
  # directory, best first; nothing if none does.
  #
  # The score is the length of the pattern, longest first: a proxy for
  # specificity measured on the pattern rather than the matched text, so a
  # catch-all `.*` always sorts last. Ties break on LC_ALL=C file path order.
  #
  # grep -Eq rather than [[ =~ ]] so a pattern means the same thing whatever
  # language printed it. A configuration that fails, prints nothing, or
  # prints an invalid regex simply does not match.
  #
  # Args:
  #   $1: path: the resolved directory a session would be rooted at
  local path="$1"

  local file pattern
  while IFS= read -r file; do
    pattern=$(
      export SESSION=""
      unset ROOT
      run_config "$file" pattern 2>/dev/null
    ) || continue

    [ -n "$pattern" ] || continue

    if printf '%s' "$path" | grep -Eq -- "$pattern" 2>/dev/null; then
      printf '%s\t%s\n' "${#pattern}" "$file"
    fi
  done < <(config_files) | LC_ALL=C sort -t$'\t' -k1,1nr -k2,2
}

matching_config_for_root() {
  # Echo the configuration claiming the directory (the top of the ranking),
  # or nothing with a non-zero status.
  #
  # Args:
  #   $1: path: the resolved directory a session would be rooted at
  local path="$1"

  local score file
  while IFS=$'\t' read -r score file; do
    printf '%s\n' "$file"
    return 0
  done < <(rank_configs_for_root "$path")

  return 1
}

config_session_name() {
  # Echo the session name configuration $1 gives directory $2, or nothing
  # with a non-zero status when it has no opinion. The directory arrives as
  # both the verb's argument and ROOT; SESSION is unset, being the thing
  # computed. Only the first line is read, whitespace-trimmed. Failing or
  # printing nothing is not an error: the default naming takes over. What is
  # printed is sanitized rather than refused, since names come from things
  # the configuration does not control (a branch, a directory).
  #
  # Args:
  #   $1: file: path to the configuration
  #   $2: path: the resolved directory the configuration matched
  local file="$1" path="$2" name

  name=$(
    export ROOT="$path"
    unset SESSION
    run_config "$file" name "$path" 2>/dev/null \
      | head -n 1 \
      | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
  ) || return 1

  [ -n "$name" ] || return 1

  sanitize_session_name "$name"
}

report_name_collision() {
  # Explain a name collision on stderr: the derived name, the directory it
  # was derived for, and where the session holding it already lives.
  #
  # Args:
  #   $1: name: the derived session name
  #   $2: path: the directory a session is being created for
  #   $3: existing: the directory the session already called $1 was started at
  local name="$1" path="$2" existing="$3"
  local red reset
  red=$(tput setaf 1) reset=$(tput sgr0)

  {
    printf '%sSession name collision%s\n' "$red" "$reset"
    printf '  %-18s%s\n' 'name' "$name"
    printf '  %-18s%s\n' 'new session at' "$path"
    printf '  %-18s%s\n' "'$name' is open at" "${existing:-(unknown)}"
  } >&2
}

session_name_prompt() {
  # Prompt for a session name, offering $2 as the default. Echoes the name.
  #
  # Args:
  #   $1: path: the directory the session will be created at
  #   $2: session_name: the name to offer as the default
  #   $3: quiet: optional; any value suppresses the path header
  local path="$1"
  local session_name="$2"
  local quiet="$3"

  [ -n "$quiet" ] || printf "%s\n" "$(tput setaf 8)$path$(tput sgr0)" >&2
  while true; do
    local prompt="Enter session name"
    if ! tmux has-session -t "=$session_name" 2>/dev/null; then
      prompt="$prompt [$(tput setaf 4)${session_name}$(tput sgr0)]"
    fi
    # A read that cannot be answered ends this rather than looping: under
    # tmux's run-shell there is no terminal, and an unanswerable prompt in a
    # loop is a hang.
    if ! read -rp "$prompt: " user_input; then
      printf "\n" >&2
      notify "Error: no terminal to read a session name from"
      return 1
    fi

    local candidate="${user_input:-$session_name}"

    # `.` and `:` are tmux target separators; a name holding either could be
    # created but never targeted again. Rejected rather than rewritten: a
    # typed name is not tsm's to change. `/` is fine (repo/worktree).
    case "$candidate" in
      *[:.]*)
        printf "$(tput setaf 1)Session names cannot contain ':' or '.'$(tput sgr0)\n" >&2
        continue
        ;;
    esac

    session_name="$candidate"
    if ! tmux has-session -t "=$session_name" 2>/dev/null; then
      break
    fi
    printf "$(tput setaf 1)Session '%s' already exists.$(tput sgr0)\n" "$session_name" >&2
  done
  echo "$session_name"
}

#################
# api functions #
#################
active_session() {
  local session="$1"

  # No session given: pick one with fzf.
  if [ -z "$session" ]; then
    local active_sessions
    active_sessions=$(get_active_sessions)

    if [ -z "$active_sessions" ]; then
      notify "No active sessions"
      exit 1
    fi

    session=$(echo "$active_sessions" | fzf --cycle --prompt "Session > ")

    if [ -z "$session" ]; then
      exit 0
    fi
  fi

  if ! tmux has-session -t "=$session" 2>/dev/null; then
    notify "Error: Session '$session' is not running"
    exit 1
  fi

  switch_or_attach "$session"
}

last_session() {
  # Switch to the most recently visited session that is still open: what
  # `tmux switch-client -l` gets at, but robust to the previous session
  # having been closed since. HISTORY_FILE is oldest first, so it is walked
  # newest first for the first session that is not the current one.
  if [ ! -f "$HISTORY_FILE" ]; then
    notify "No session history yet -- see README for the tmux.conf hook 'tsm last' needs"
    exit 1
  fi

  # Sessions closed since the last switch are still in the file here.
  prune_history

  local current=""
  [ -n "$TMUX" ] && current=$(tmux display-message -p '#S' 2>/dev/null)

  local target=""
  while IFS= read -r session; do
    if [ "$session" != "$current" ]; then
      target="$session"
      break
    fi
  done < <(tac "$HISTORY_FILE" 2>/dev/null || tail -r "$HISTORY_FILE" 2>/dev/null)

  if [ -z "$target" ]; then
    notify "No previous session still open"
    exit 1
  fi

  switch_or_attach "$target"
}

kill_session() {
  local session="$1"

  # No session given: pick one with fzf.
  if [ -z "$session" ]; then
    local active_sessions
    active_sessions=$(get_active_sessions)

    if [ -z "$active_sessions" ]; then
      notify "No active sessions to kill"
      exit 1
    fi

    session=$(echo "$active_sessions" | fzf --cycle --prompt "Kill Session > ")

    if [ -z "$session" ]; then
      exit 0
    fi
  fi

  if ! tmux has-session -t "=$session" 2>/dev/null; then
    notify "Error: Session '$session' is not running"
    exit 1
  fi

  local log_dir="$LOG_DIR/$session"
  local log_file="$log_dir/tsm.log"
  mkdir -p "$log_dir"

  # The configuration that built the session is read back from the marker
  # rather than resolved again, so it is torn down by the one that built it
  # even if the patterns have since changed. A session created with -c
  # recorded no marker and gets no cleanup.
  local matching_config
  matching_config=$(tmux show-environment -t "=$session" TSM_MATCHING_CONFIG 2>/dev/null | sed 's/^TSM_MATCHING_CONFIG=//')

  local session_file=""
  if [ -n "$matching_config" ]; then
    session_file=$(config_file_for_name "$matching_config") || session_file=""
  fi

  # The kill hook runs in the background so the session goes away immediately
  # rather than waiting on cleanup; tsm kills the session itself either way.
  if [ -n "$session_file" ]; then
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Killing session '$session'" > "$log_file"

    # ROOT comes from @tsm_path, so `kill` sees the ROOT that `start` saw.
    local session_root
    session_root=$(path_for_session "$session")

    nohup env SESSION="$session" ROOT="${session_root:-$HOME}" \
      "$session_file" kill >> "$log_file" 2>&1 &
  fi

  tmux kill-session -t "=$session"
}

match_configs() {
  # Print how a directory ranks against every configuration that claims it,
  # one "<score>\t<file>" per line, best first. Precedence depends on every
  # other file too, so being able to ask beats guessing.
  #
  # Args:
  #   $1: path: directory to test; defaults to the current directory
  local path="${1:-$PWD}"

  path="${path/#\~/$HOME}"

  local resolved
  if ! resolved=$(cd "$path" 2>/dev/null && pwd -P); then
    notify "Error: Directory '$path' does not exist"
    exit 1
  fi

  local ranked
  ranked=$(rank_configs_for_root "$resolved")

  # No match is an answer, not a failure, but the non-zero status makes it
  # testable, and saying so on stderr keeps stdout clean for callers.
  if [ -z "$ranked" ]; then
    notify "No configuration claims $resolved"
    exit 1
  fi

  printf '%s\n' "$ranked"
}

###################################################
# the session: the one thing every picker ends in #
###################################################

session_at() {
  # Switch to the session already open at a directory, or create one there.
  #
  # Args:
  #   $1: path: the directory a picker named
  #   $@: --no-config, --prompt-name
  local selected="$1"
  shift

  local no_config="" prompt_name="" arg
  for arg in "$@"; do
    case "$arg" in
      --no-config) no_config=1 ;;
      --prompt-name) prompt_name=1 ;;
    esac
  done

  selected="${selected/#\~/$HOME}"

  # Resolved here rather than in the pickers: a session is identified by the
  # directory it was started at, so every path has to arrive in the same
  # form no matter who printed it.
  local resolved
  if ! resolved=$(cd "$selected" 2>/dev/null && pwd -P); then
    notify "Error: Directory '$selected' does not exist"
    exit 1
  fi
  selected="$resolved"

  # A session is identified by the directory it was started at, not by its
  # name: picking a directory that already has a session returns to it,
  # whatever it has been renamed to. Nothing is being created, so this is
  # also the answer -p gets.
  local existing
  if existing=$(session_for_path "$selected"); then
    switch_or_attach "$existing"
    exit 0
  fi

  # A configuration may claim the path with `pattern`, naming the session
  # (`name`) and building it (`start`). -c opts out of both.
  local matching_file="" matching_config=""
  if [ -z "$no_config" ]; then
    if matching_file=$(matching_config_for_root "$selected"); then
      matching_config=$(config_name_for_file "$matching_file")
    else
      matching_file=""
    fi
  fi

  # The configuration's name if it has an opinion, the directory's otherwise.
  local session_name=""
  [ -n "$matching_file" ] && session_name=$(config_session_name "$matching_file" "$selected")
  [ -n "$session_name" ] || session_name=$(default_session_name "$selected")

  if [ -n "$prompt_name" ]; then
    # -p is the last word: the rules still make the suggestion, but anything
    # typed over it wins. session_name_prompt returns rather than exits
    # because an exit inside a command substitution only ends the subshell.
    session_name=$(session_name_prompt "$selected" "$session_name") || exit 1
  else
    # The path is not open (settled above), so a session already holding this
    # name is a genuine collision: two directories whose names landed on the
    # same string. Switching there would go somewhere that was not picked, so
    # report it and ask for a name.
    if tmux has-session -t "=$session_name" 2>/dev/null; then
      local taken="$session_name" existing_path
      existing_path=$(path_for_session "$taken")
      report_name_collision "$taken" "$selected" "$existing_path"

      # quiet: the report already put the path on stderr.
      session_name=$(session_name_prompt "$selected" "$taken" quiet) || {
        # The prompt's error goes to stderr, which has nowhere to land under
        # tmux's run-shell; notify becomes a tmux message there.
        notify "Error: session '$taken' is already open at ${existing_path:-an unknown path}; $selected needs a name of its own"
        exit 1
      }
    fi
  fi

  local width height
  read -r width height < <(client_size)

  # Sized up front: tmux creates detached sessions at 80x24, and percentage
  # splits made before the client attaches drift once the real size arrives.
  tmux new-session -d -s "$session_name" -c "$selected" ${width:+-x "$width"} ${height:+-y "$height"} || exit 1

  # Record the directory on the session itself; this is what identifies it.
  # The trailing `:` is load-bearing: set-option takes a target pane, and
  # `=name` alone is read as a pane target and fails to resolve, while
  # `=name:` is that session's current pane.
  tmux set-option -t "=$session_name:" @tsm_path "$selected"

  if [ -n "$matching_file" ]; then
    # A session no configuration claimed runs no script, so it gets no log.
    local log_dir="$LOG_DIR/$session_name"
    local log_file="$log_dir/tsm.log"
    mkdir -p "$log_dir"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting session '$session_name'" > "$log_file"

    # Subshell so a configuration aborting under its own `set -e` does not
    # tear down a session tmux already created. The marker is recorded inside
    # it: it is only true once the configuration has actually been applied,
    # and kill_session reads it to know which file owns the cleanup.
    (
      export SESSION="$session_name" ROOT="$selected"
      run_config "$matching_file" start
      tmux set-environment -t "=$session_name" TSM_MATCHING_CONFIG "$matching_config"
    ) >> "$log_file" 2>&1
  fi

  switch_or_attach "$session_name"
}

at_path() {
  # Start a session at a directory, or switch to the session already open
  # there:
  #
  #   tsm at <path> [-c] [-p]
  #
  # A path and nothing else. `tsm via` is the same thing with a program
  # printing the path instead.
  local session_flags=() paths=() arg
  expand_short_flags "$@"
  for arg in "${EXPANDED_ARGS[@]}"; do
    case "$arg" in
      -c | --no-config) session_flags+=(--no-config) ;;
      -p | --prompt-name) session_flags+=(--prompt-name) ;;
      -*)
        notify "Error: Unknown option '$arg' for 'tsm at'"
        exit 1
        ;;
      *) paths+=("$arg") ;;
    esac
  done

  if [ "${#paths[@]}" -ne 1 ]; then
    notify "Error: 'tsm at' takes one directory"
    exit 1
  fi

  session_at "${paths[0]}" ${session_flags+"${session_flags[@]}"}
}

via_picker() {
  # Start a session at the directory a picker prints, or switch to the
  # session already open there:
  #
  #   tsm via [-c] [-p] <picker> [picker args]
  #
  # The picker is a built-in name or any program that prints a path; the
  # arguments after it are the program's own, so the session flags have to
  # come first -- `-i` in `zoxide query -i` belongs to zoxide, not to tsm,
  # and there is no way to tell them apart after the fact.
  #
  # Only the arguments before the picker are read as flags, and only they are
  # expanded: after it, -la is the program's business and not two flags of
  # tsm's.
  local session_flags=() arg
  while [ $# -gt 0 ]; do
    case "$1" in
      --) shift; break ;;
      -[!-]* | --*) ;;
      *) break ;;
    esac

    expand_short_flags "$1"
    for arg in "${EXPANDED_ARGS[@]}"; do
      case "$arg" in
        -c | --no-config) session_flags+=(--no-config) ;;
        -p | --prompt-name) session_flags+=(--prompt-name) ;;
        *)
          notify "Error: Unknown option '$arg' for 'tsm via'"
          exit 1
          ;;
      esac
    done
    shift
  done

  if [ $# -eq 0 ]; then
    notify "Error: 'tsm via' takes a program that prints a path, such as 'tsm pick dir'"
    exit 1
  fi

  run_picker "$@" || exit 0

  session_at "$PICKED_DIR" ${session_flags+"${session_flags[@]}"}
}

pick_command() {
  # Print the directory a built-in picker names:
  #
  #   tsm pick <name>
  #
  # A picker in the ordinary sense -- a program printing one path -- which is
  # how the built-in ones reach `tsm via` without tsm reserving their names:
  #
  #   tsm via tsm pick git
  #
  # Backing out of the fzf prints nothing and succeeds, the same way any
  # other picker declines to answer.
  pick_builtin "$@" || exit 0

  printf '%s\n' "$PICKED_DIR"
}

browse_logs() {
  local session="$1"

  local search_dir
  if [ -n "$session" ]; then
    search_dir="$LOG_DIR/$session"
    if [ ! -d "$search_dir" ]; then
      notify "Error: No log directory found for session '$session'"
      exit 1
    fi
  else
    search_dir="$LOG_DIR"
  fi

  local log_files
  log_files=$(find "$search_dir" -type f -name '*.log' 2>/dev/null | sed "s|^$LOG_DIR/||" | sort)

  if [ -z "$log_files" ]; then
    notify "No log files found"
    exit 1
  fi

  local selected
  selected=$(echo "$log_files" | fzf \
    --cycle \
    --bind=ctrl-d:preview-half-page-down \
    --bind=ctrl-u:preview-half-page-up \
    --bind="ctrl-o:execute(${EDITOR:-vi} '$LOG_DIR/{}')" \
    --prompt "Logs > " \
    --header $':: \e[33mEnter\e[0m to \e[31mtail\e[0m | \e[33mctrl-o\e[0m to \e[31mopen in editor\e[0m | \e[33mctrl-d\e[0m to \e[31mpreview page down\e[0m | \e[33mctrl-u\e[0m to \e[31mpreview page up\e[0m' \
    --preview "tail -n 100000 -f '$LOG_DIR/{}'" \
    --preview-window follow)

  if [ -z "$selected" ]; then
    exit 0
  fi

  tail -n 1000 -f "$LOG_DIR/$selected"
}

# Parse arguments
if [ $# -eq 0 ]; then
  usage
  exit 0
fi

command="$1"
shift

case "$command" in
  active)
    active_session "$1"
    ;;
  last)
    last_session
    ;;
  kill)
    kill_session "$1"
    ;;
  at)
    at_path "$@"
    ;;
  via)
    via_picker "$@"
    ;;
  pick)
    pick_command "$@"
    ;;
  match)
    match_configs "$1"
    ;;
  logs)
    browse_logs "$1"
    ;;
  _record-switch)
    # Internal: invoked by the client-session-changed hook (see README).
    record_switch "$1" "$2"
    ;;
  _pickers)
    # Internal: the built-in picker names `tsm pick` takes, for the shell
    # completions.
    pickers
    ;;
  help)
    usage
    ;;
  *)
    notify "Error: Unknown command '$command'"
    usage
    exit 1
    ;;
esac
