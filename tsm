#!/bin/bash

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/tsm"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/tsm"
LOG_DIR="$STATE_DIR/logs"
HISTORY_FILE="$STATE_DIR/session_history"
BOOKMARKS_FILE="$STATE_DIR/bookmarks.json"
mkdir -p "$CONFIG_DIR" "$LOG_DIR"

TSM_DIRS_CMD_DEFAULT='find "$HOME" -maxdepth 4 -name ".*" -prune -o -type d \( -exec test -e {}/.git \; -print -prune -o -print \)'
TSM_GIT_DIRS_CMD_DEFAULT='find "$HOME" -maxdepth 4 -name ".*" -prune -o -type d -exec test -e {}/.git \; -print -prune 2>/dev/null'

usage() {
  cat <<'EOF'
Tmux Session Manager

Usage
  tsm                                      # Show help message
  tsm active [session]                     # Switch to an existing session
  tsm kill [session]                       # Kill session (runs its kill hook if present)
  tsm last                                 # Switch to the most recent session that is still open

  tsm create-or-switch <picker> [-c] [-p] [arg]
                                           # Start a session at the directory <picker> names, or
                                           # switch to the session already open there

    -c, --no-config                        # Ignore any configuration claiming the picked path
    -p, --prompt-name                      # Prompt for the session name instead of using the default

  tsm bookmark-add <char> [path]           # Bookmark a directory (path defaults to the current directory)
  tsm bookmark-remove <char>               # Remove a bookmark
  tsm bookmark-status [path]               # Bookmarks of the open sessions, for a tmux status line (-s, -c set its styles)

  tsm match [path]                         # Configurations claiming a path, best first (defaults to the current directory)
  tsm logs [session]                       # Browse session logs

  tsm help                                 # Show help message

  tsm <name> [args]                        # Run tsm-<name> from PATH, as git does for its own external commands

Pickers
  A picker names a directory and nothing else: it takes none of the flags
  above, decides nothing about the session, and prints one path on stdout.
  Anything on PATH called tsm-<name> is one.

  dir [path]                               # Any directory, with fzf, or the path given
  git [path]                               # A git repository, with fzf, or the path given
  worktree [name]                          # A worktree of this repository, with fzf, or the one named
  bookmark [char]                          # A bookmarked directory, with fzf, or the one keyed to char
EOF

  # The tsm-* pickers that are actually installed, so `tsm help` says what
  # this machine can pick with.
  local externals name
  externals=$(external_commands)

  if [ -n "$externals" ]; then
    while IFS= read -r name; do
      [ -n "$name" ] && printf '  %-40s # tsm-%s\n' "$name" "$name"
    done <<< "$externals"
  fi

  printf '\nSee https://github.com/ryanburda/tmux-session-manager for more documentation\n'
}

####################
# helper functions #
####################
notify() {
  # Show a message: tmux display-message inside tmux, stderr otherwise.
  # stderr because several callers run inside a command substitution whose
  # stdout is their return value.
  local msg="$1"
  if [ -n "$TMUX" ]; then
    tmux display-message "$msg"
  else
    echo "$msg" >&2
  fi
}

get_active_sessions() {
  # Active session names, one per line. Formatted rather than cut out of
  # `tmux ls`, which would split a name at its first colon.
  tmux list-sessions -F '#{session_name}' 2>/dev/null
}

prune_history() {
  # Drop sessions that are no longer running from HISTORY_FILE.
  [ -f "$HISTORY_FILE" ] || return 0

  local active
  active=$(get_active_sessions)

  # Whole-line keys, so a session name is never read as a pattern. Passed via
  # the environment: -v would expand backslashes in a name.
  TSM_ACTIVE="$active" awk '
    BEGIN {
      n = split(ENVIRON["TSM_ACTIVE"], names, "\n")
      for (i = 1; i <= n; i++) live[names[i]]
    }
    $0 in live
  ' "$HISTORY_FILE" > "$HISTORY_FILE.tmp" && mv "$HISTORY_FILE.tmp" "$HISTORY_FILE"
}

record_switch() {
  # Append the session being switched away from to HISTORY_FILE for `tsm last`.
  # Fired by the client-session-changed hook the user registers (see README).
  #
  # Args:
  #   $1: from: the session that was left
  #   $2: to: the session that was switched to
  local from="$1" to="$2"

  [ -n "$from" ] && [ "$from" != "$to" ] || return

  # Prune + dedupe on every write bounds the file at one line per running
  # session. -Fx matches the whole line literally, not as a regex.
  prune_history
  if [ -f "$HISTORY_FILE" ]; then
    grep -Fxv -- "$from" "$HISTORY_FILE" > "$HISTORY_FILE.tmp" 2>/dev/null
    mv "$HISTORY_FILE.tmp" "$HISTORY_FILE"
  fi

  echo "$from" >> "$HISTORY_FILE"
}

refresh_status() {
  # Redraw every attached client's status line. tmux's own refresh-client
  # reaches only one client, and a status line passing #{session_path} gives
  # each client a #() job of its own, so all of them need the nudge.
  local client

  while IFS= read -r client; do
    [ -n "$client" ] && tmux refresh-client -S -t "$client" 2>/dev/null
  done < <(tmux list-clients -F '#{client_name}' 2>/dev/null)
}

switch_or_attach() {
  # Switch to a session if inside tmux, attach otherwise.
  local session="$1"
  if [ -n "$TMUX" ]; then
    tmux switch-client -t "=$session"
  else
    tmux attach-session -t "=$session"
  fi
}

session_paths() {
  # Emit "<session name>\t<path>" for every running session. The path is the
  # @tsm_path recorded at creation; #{session_path} is the fallback for
  # sessions tsm did not create (it drifts as the first pane cds around,
  # which is why @tsm_path exists).
  tmux list-sessions -F $'#{session_name}\t#{@tsm_path}\t#{session_path}' 2>/dev/null \
    | while IFS=$'\t' read -r name recorded fallback; do
        printf '%s\t%s\n' "$name" "${recorded:-$fallback}"
      done
}

session_for_path() {
  # Echo the running session started at $1, or nothing with a non-zero status.
  # Compared in the shell: tmux's filter parser reads `,` and `}` in a path.
  local want="$1" name path
  while IFS=$'\t' read -r name path; do
    [ "$path" = "$want" ] || continue
    printf '%s\n' "$name"
    return 0
  done < <(session_paths)
  return 1
}

path_for_session() {
  # Echo the path the session named $1 was started at, or nothing with a
  # non-zero status.
  local want="$1" name path
  while IFS=$'\t' read -r name path; do
    [ "$name" = "$want" ] || continue
    printf '%s\n' "$path"
    return 0
  done < <(session_paths)
  return 1
}

sanitize_session_name() {
  # Replace every character outside [A-Za-z0-9_-/] with _. `/` survives for
  # repo/worktree names; `.` and `:` must not, being tmux target separators.
  # Takes a name, not a path: callers take the basename themselves.
  printf '%s' "$1" | tr -c 'a-zA-Z0-9_/-' '_'
}

client_size() {
  # Print "WIDTH HEIGHT" for the client that will attach, or nothing. tmux
  # creates detached sessions at 80x24, so percentage splits made before the
  # client attaches drift once the real size arrives; sizing up front avoids
  # that.
  local width height

  width=$(tmux display-message -p '#{client_width}' 2>/dev/null)
  height=$(tmux display-message -p '#{client_height}' 2>/dev/null)

  # Outside tmux, fall back to the terminal tsm was invoked from.
  if [ -z "$width" ] || [ -z "$height" ]; then
    read -r height width < <({ stty size < /dev/tty; } 2>/dev/null)
  fi

  case "$width$height" in
    *[!0-9]* | '') return 1 ;;
  esac

  # A pty with no size set answers `0 0`, which tmux refuses.
  [ "$width" -gt 0 ] && [ "$height" -gt 0 ] || return 1

  echo "$width $height"
}

tsm_self() {
  # Echo the path to re-run tsm by. A bare name is resolved against the
  # current PATH, since tmux and fzf run the command later in an environment
  # whose PATH may differ.
  local self="$0"

  case "$self" in
    */*) ;;
    *) self=$(command -v -- "$self" 2>/dev/null) || self="$0" ;;
  esac

  echo "$self"
}

expand_short_flags() {
  # Split clustered short flags (-cp -> -c -p) into EXPANDED_ARGS so the
  # subcommand parsers see one flag per argument. Everything else passes
  # through untouched.
  EXPANDED_ARGS=()
  local arg i
  for arg in "$@"; do
    case "$arg" in
      -[!-]*)
        for (( i = 1; i < ${#arg}; i++ )); do
          EXPANDED_ARGS+=("-${arg:i:1}")
        done
        ;;
      *) EXPANDED_ARGS+=("$arg") ;;
    esac
  done
}

external_commands() {
  # Names of the tsm-* programs on PATH, one per line and without the prefix:
  # exactly the names `tsm <name>` will find. Anything executable and named
  # tsm-<name> is one, the same rule git uses for its own external commands.
  local dir file base
  local IFS=:

  for dir in $PATH; do
    # An empty PATH entry means the current directory, as it does everywhere.
    [ -n "$dir" ] || dir=.

    # With no match the glob yields the pattern itself, which the tests below
    # then reject; nullglob is not assumed to be set.
    for file in "$dir"/tsm-*; do
      [ -f "$file" ] && [ -x "$file" ] || continue
      base="${file##*/}"
      printf '%s\n' "${base#tsm-}"
    done
  done | LC_ALL=C sort -u
}

default_session_name() {
  # Derive a session name for a directory: repo/worktree for a linked
  # worktree, the sanitized basename otherwise. Two worktrees whose paths end
  # in the same segment derive the same name; that is caught later as a name
  # collision, since a session is identified by its path.
  #
  # Args:
  #   $1: path: directory to derive the session name from
  local path="$1"

  local git_dir
  git_dir=$(git -C "$path" rev-parse --absolute-git-dir 2>/dev/null)

  # A linked worktree's git dir is <common dir>/worktrees/<name> and holds a
  # gitdir file. Both are tested: inside a subdirectory of an ordinary repo,
  # rev-parse also answers absolutely.
  if [ -n "$git_dir" ] && [ -f "$git_dir/gitdir" ] &&
    [ "$(basename "$(dirname "$git_dir")")" = "worktrees" ]; then
    local repo_dir
    repo_dir=$(dirname "$(dirname "$git_dir")")
    local repo_leaf
    repo_leaf=$(basename "$repo_dir")

    # Step over conventional bare-repo wrappers: worktrees of
    # ~/code/api/.bare belong to `api`, not `.bare`.
    local repo_name
    if [ "$repo_leaf" = ".bare" ] || [ "$repo_leaf" = ".git" ]; then
      repo_name=$(basename "$(dirname "$repo_dir")")
    else
      repo_name="$repo_leaf"
    fi

    # Sanitized separately, so the joining `/` is the only one: a worktree
    # directory named v1.2 would otherwise put a `.` in the name.
    echo "$(sanitize_session_name "$repo_name")/$(sanitize_session_name "$(basename "$path")")"
  else
    sanitize_session_name "$(basename "$path")"
  fi
}

config_files() {
  # Paths of the configuration files under $CONFIG_DIR, one per line.
  # A configuration is an executable program; tsm runs it with a verb and
  # reads its answer.
  #
  # -L: configurations are commonly symlinks. -perm -u+x: -executable is
  # GNU-only. LC_ALL=C sort: tie-breaking must not depend on the locale.
  [ -d "$CONFIG_DIR" ] || return

  find -L "$CONFIG_DIR" -type f -perm -u+x 2>/dev/null | LC_ALL=C sort
}

config_name_for_file() {
  # Echo the configuration name for a file: its path under $CONFIG_DIR minus
  # any final extension, so `work`, `work.sh` and `work.fish` are all `work`.
  # A leading dot is not an extension: `.work.fish` is `.work`.
  #
  # Args:
  #   $1: file: path to a configuration file under $CONFIG_DIR
  local rel base dir="" dot=""
  rel="${1#"$CONFIG_DIR/"}"

  base="${rel##*/}"
  [ "$base" = "$rel" ] || dir="${rel%/*}/"

  case "$base" in .*) dot="."; base="${base#.}" ;; esac
  case "$base" in *.*) base="${base%.*}" ;; esac

  printf '%s%s%s\n' "$dir" "$dot" "$base"
}

config_file_for_name() {
  # Echo the path of the configuration named $1, or nothing with a non-zero
  # status. A search, since the extension is not knowable from the name;
  # first match in LC_ALL=C order wins.
  #
  # Args:
  #   $1: name: a configuration name, as config_name_for_file produces
  local want="$1" file
  while IFS= read -r file; do
    if [ "$(config_name_for_file "$file")" = "$want" ]; then
      printf '%s\n' "$file"
      return 0
    fi
  done < <(config_files)
  return 1
}

run_config() {
  # Run a configuration with a verb: pattern, name, start or kill. The
  # contract is argv in, stdout and exit status out; tsm never looks inside
  # the file. A verb the program does not handle must exit 0. Only `pattern`
  # and `name` treat stdout as an answer; for `start` and `kill` it is the
  # session log, and callers redirect it there.
  #
  # set -m gives background jobs their own process group; the subshell keeps
  # a configuration that exits from taking tsm with it.
  #
  # Args:
  #   $1: file: path to the configuration
  #   $2: verb: one of pattern, name, start, kill
  #   $@: any further arguments the verb takes
  local file="$1" verb="$2"
  shift 2
  ( set -m; exec "$file" "$verb" "$@" )
}

rank_configs_for_root() {
  # Emit "<score>\t<file>" for every configuration whose pattern claims the
  # directory, best first; nothing if none does.
  #
  # The score is the length of the pattern, longest first: a proxy for
  # specificity measured on the pattern rather than the matched text, so a
  # catch-all `.*` always sorts last. Ties break on LC_ALL=C file path order.
  #
  # grep -Eq rather than [[ =~ ]] so a pattern means the same thing whatever
  # language printed it. A configuration that fails, prints nothing, or
  # prints an invalid regex simply does not match.
  #
  # Args:
  #   $1: path: the resolved directory a session would be rooted at
  local path="$1"

  local file pattern
  while IFS= read -r file; do
    pattern=$(
      export SESSION=""
      unset ROOT
      run_config "$file" pattern 2>/dev/null
    ) || continue

    [ -n "$pattern" ] || continue

    if printf '%s' "$path" | grep -Eq -- "$pattern" 2>/dev/null; then
      printf '%s\t%s\n' "${#pattern}" "$file"
    fi
  done < <(config_files) | LC_ALL=C sort -t$'\t' -k1,1nr -k2,2
}

matching_config_for_root() {
  # Echo the configuration claiming the directory (the top of the ranking),
  # or nothing with a non-zero status.
  #
  # Args:
  #   $1: path: the resolved directory a session would be rooted at
  local path="$1"

  local score file
  while IFS=$'\t' read -r score file; do
    printf '%s\n' "$file"
    return 0
  done < <(rank_configs_for_root "$path")

  return 1
}

config_session_name() {
  # Echo the session name configuration $1 gives directory $2, or nothing
  # with a non-zero status when it has no opinion. The directory arrives as
  # both the verb's argument and ROOT; SESSION is unset, being the thing
  # computed. Only the first line is read, whitespace-trimmed. Failing or
  # printing nothing is not an error: the default naming takes over. What is
  # printed is sanitized rather than refused, since names come from things
  # the configuration does not control (a branch, a directory).
  #
  # Args:
  #   $1: file: path to the configuration
  #   $2: path: the resolved directory the configuration matched
  local file="$1" path="$2" name

  name=$(
    export ROOT="$path"
    unset SESSION
    run_config "$file" name "$path" 2>/dev/null \
      | head -n 1 \
      | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
  ) || return 1

  [ -n "$name" ] || return 1

  sanitize_session_name "$name"
}

report_name_collision() {
  # Explain a name collision on stderr: the derived name, the directory it
  # was derived for, and where the session holding it already lives.
  #
  # Args:
  #   $1: name: the derived session name
  #   $2: path: the directory a session is being created for
  #   $3: existing: the directory the session already called $1 was started at
  local name="$1" path="$2" existing="$3"
  local red reset
  red=$(tput setaf 1) reset=$(tput sgr0)

  {
    printf '%sSession name collision%s\n' "$red" "$reset"
    printf '  %-18s%s\n' 'name' "$name"
    printf '  %-18s%s\n' 'new session at' "$path"
    printf '  %-18s%s\n' "'$name' is open at" "${existing:-(unknown)}"
  } >&2
}

session_name_prompt() {
  # Prompt for a session name, offering $2 as the default. Echoes the name.
  #
  # Args:
  #   $1: path: the directory the session will be created at
  #   $2: session_name: the name to offer as the default
  #   $3: quiet: optional; any value suppresses the path header
  local path="$1"
  local session_name="$2"
  local quiet="$3"

  [ -n "$quiet" ] || printf "%s\n" "$(tput setaf 8)$path$(tput sgr0)" >&2
  while true; do
    local prompt="Enter session name"
    if ! tmux has-session -t "=$session_name" 2>/dev/null; then
      prompt="$prompt [$(tput setaf 4)${session_name}$(tput sgr0)]"
    fi
    # A read that cannot be answered ends this rather than looping: under
    # tmux's run-shell there is no terminal, and an unanswerable prompt in a
    # loop is a hang.
    if ! read -rp "$prompt: " user_input; then
      printf "\n" >&2
      notify "Error: no terminal to read a session name from"
      return 1
    fi

    local candidate="${user_input:-$session_name}"

    # `.` and `:` are tmux target separators; a name holding either could be
    # created but never targeted again. Rejected rather than rewritten: a
    # typed name is not tsm's to change. `/` is fine (repo/worktree).
    case "$candidate" in
      *[:.]*)
        printf "$(tput setaf 1)Session names cannot contain ':' or '.'$(tput sgr0)\n" >&2
        continue
        ;;
    esac

    session_name="$candidate"
    if ! tmux has-session -t "=$session_name" 2>/dev/null; then
      break
    fi
    printf "$(tput setaf 1)Session '%s' already exists.$(tput sgr0)\n" "$session_name" >&2
  done
  echo "$session_name"
}

check_bookmark_char() {
  # Exit unless $1 can key a bookmark: a single printable ASCII character.
  # Checked by code point rather than a [!-~] range, which outside the C
  # locale is read in collation order.
  #
  # Args:
  #   $1: char: the character to check
  local char="$1" code

  if [ "${#char}" -eq 1 ]; then
    code=$(printf '%d' "'$char" 2>/dev/null)
    if [ -n "$code" ] && [ "$code" -ge 33 ] && [ "$code" -le 126 ]; then
      return 0
    fi
  fi

  notify "Error: a bookmark is keyed by a single printable character"
  exit 1
}

read_bookmarks() {
  # Emit one "char<TAB>directory" line per bookmark, sorted by character.
  #
  # Bookmarks are a flat JSON object of character -> directory, parsed here
  # rather than with jq to avoid the dependency: the file holds only strings,
  # and only the escapes write_bookmarks produces. A pair whose key is not a
  # single character, or whose value is empty or holds a tab or newline, is
  # dropped: tsm cannot write one, and it would split a line callers read
  # whole.
  [ -f "$BOOKMARKS_FILE" ] || return 0

  awk '
    { json = json $0 "\n" }

    # Decodes the JSON string starting at i (its opening quote), leaving i on
    # the character after its closing quote.
    function read_string(   out, c, e) {
      out = ""
      i++
      while (i <= n) {
        c = substr(json, i, 1)
        if (c == "\"") { i++; break }
        if (c == "\\") {
          e = substr(json, i + 1, 1)
          if (e == "n") c = "\n"
          else if (e == "t") c = "\t"
          else if (e == "r") c = "\r"
          else if (e == "b") c = "\b"
          else if (e == "f") c = "\f"
          else c = e
          i++
        }
        out = out c
        i++
      }
      return out
    }

    END {
      n = length(json)
      i = 1

      # The object is flat, so its strings alternate key, value.
      while (i <= n) {
        if (substr(json, i, 1) != "\"") { i++; continue }
        key = read_string()

        # Skip the colon and whitespace between key and value.
        while (i <= n && substr(json, i, 1) != "\"") i++
        if (i > n) break
        val = read_string()

        if (length(key) == 1 && val != "" && val !~ /[\t\n]/) print key "\t" val
      }
    }
  ' "$BOOKMARKS_FILE" | LC_ALL=C sort
}

write_bookmarks() {
  # Read "char<TAB>directory" lines on stdin and replace the store with them.
  # Written to a temp file and moved into place, so an interrupted write
  # leaves the old bookmarks rather than half a file.
  local tmp="$BOOKMARKS_FILE.tmp"

  awk -F'\t' '
    # A character at a time rather than gsub, whose replacement text has
    # escaping rules of its own.
    function escape(s,   out, i, c) {
      out = ""
      for (i = 1; i <= length(s); i++) {
        c = substr(s, i, 1)
        if (c == "\"" || c == "\\") out = out "\\"
        out = out c
      }
      return out
    }

    BEGIN { printf "{\n" }
    NF >= 2 { printf "%s  \"%s\": \"%s\"", (count++ ? ",\n" : ""), escape($1), escape($2) }
    END { printf "%s}\n", (count ? "\n" : "") }
  ' > "$tmp" && mv "$tmp" "$BOOKMARKS_FILE"
}

bookmark_directory() {
  # Echo the directory bookmarked at $1, or nothing with a non-zero status.
  #
  # Args:
  #   $1: char: the bookmark character to look up
  local char="$1" c dir

  while IFS=$'\t' read -r c dir; do
    if [ "$c" = "$char" ]; then
      echo "$dir"
      return 0
    fi
  done < <(read_bookmarks)

  return 1
}

without_bookmark() {
  # Filter "char<TAB>directory" lines on stdin, dropping the bookmark keyed
  # by $1. Passed via the environment: -v would expand backslashes.
  #
  # Args:
  #   $1: char: the bookmark character to drop
  TSM_BOOKMARK_CHAR="$1" awk -F'\t' '
    BEGIN { char = ENVIRON["TSM_BOOKMARK_CHAR"] }
    $1 != char
  '
}

bookmark_entries() {
  # The bookmark picker's rows: character and directory, tab separated,
  # followed by the "char directory" column that is displayed. fzf shows only
  # the third field (--with-nth); the first two ride along for its bindings.
  local char dir

  while IFS=$'\t' read -r char dir; do
    printf '%s\t%s\t%s    %s\n' "$char" "$dir" "$char" "${dir/#"$HOME"/\~}"
  done < <(read_bookmarks)
}

#################
# api functions #
#################
active_session() {
  local session="$1"

  # No session given: pick one with fzf.
  if [ -z "$session" ]; then
    local active_sessions
    active_sessions=$(get_active_sessions)

    if [ -z "$active_sessions" ]; then
      notify "No active sessions"
      exit 1
    fi

    session=$(echo "$active_sessions" | fzf --cycle --prompt "Session > ")

    if [ -z "$session" ]; then
      exit 0
    fi
  fi

  if ! tmux has-session -t "=$session" 2>/dev/null; then
    notify "Error: Session '$session' is not running"
    exit 1
  fi

  switch_or_attach "$session"
}

last_session() {
  # Switch to the most recently visited session that is still open: what
  # `tmux switch-client -l` gets at, but robust to the previous session
  # having been closed since. HISTORY_FILE is oldest first, so it is walked
  # newest first for the first session that is not the current one.
  if [ ! -f "$HISTORY_FILE" ]; then
    notify "No session history yet -- see README for the tmux.conf hook 'tsm last' needs"
    exit 1
  fi

  # Sessions closed since the last switch are still in the file here.
  prune_history

  local current=""
  [ -n "$TMUX" ] && current=$(tmux display-message -p '#S' 2>/dev/null)

  local target=""
  while IFS= read -r session; do
    if [ "$session" != "$current" ]; then
      target="$session"
      break
    fi
  done < <(tac "$HISTORY_FILE" 2>/dev/null || tail -r "$HISTORY_FILE" 2>/dev/null)

  if [ -z "$target" ]; then
    notify "No previous session still open"
    exit 1
  fi

  switch_or_attach "$target"
}

kill_session() {
  local session="$1"

  # No session given: pick one with fzf.
  if [ -z "$session" ]; then
    local active_sessions
    active_sessions=$(get_active_sessions)

    if [ -z "$active_sessions" ]; then
      notify "No active sessions to kill"
      exit 1
    fi

    session=$(echo "$active_sessions" | fzf --cycle --prompt "Kill Session > ")

    if [ -z "$session" ]; then
      exit 0
    fi
  fi

  if ! tmux has-session -t "=$session" 2>/dev/null; then
    notify "Error: Session '$session' is not running"
    exit 1
  fi

  local log_dir="$LOG_DIR/$session"
  local log_file="$log_dir/tsm.log"
  mkdir -p "$log_dir"

  # The configuration that built the session is read back from the marker
  # rather than resolved again, so it is torn down by the one that built it
  # even if the patterns have since changed. A session created with -c
  # recorded no marker and gets no cleanup.
  local matching_config
  matching_config=$(tmux show-environment -t "=$session" TSM_MATCHING_CONFIG 2>/dev/null | sed 's/^TSM_MATCHING_CONFIG=//')

  local session_file=""
  if [ -n "$matching_config" ]; then
    session_file=$(config_file_for_name "$matching_config") || session_file=""
  fi

  # The kill hook runs in the background so the session goes away immediately
  # rather than waiting on cleanup; tsm kills the session itself either way.
  if [ -n "$session_file" ]; then
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Killing session '$session'" > "$log_file"

    # ROOT comes from @tsm_path, so `kill` sees the ROOT that `start` saw.
    local session_root
    session_root=$(path_for_session "$session")

    nohup env SESSION="$session" ROOT="${session_root:-$HOME}" \
      "$session_file" kill >> "$log_file" 2>&1 &
  fi

  tmux kill-session -t "=$session"
}

match_configs() {
  # Print how a directory ranks against every configuration that claims it,
  # one "<score>\t<file>" per line, best first. Precedence depends on every
  # other file too, so being able to ask beats guessing.
  #
  # Args:
  #   $1: path: directory to test; defaults to the current directory
  local path="${1:-$PWD}"

  path="${path/#\~/$HOME}"

  local resolved
  if ! resolved=$(cd "$path" 2>/dev/null && pwd -P); then
    notify "Error: Directory '$path' does not exist"
    exit 1
  fi

  local ranked
  ranked=$(rank_configs_for_root "$resolved")

  # No match is an answer, not a failure, but the non-zero status makes it
  # testable, and saying so on stderr keeps stdout clean for callers.
  if [ -z "$ranked" ]; then
    notify "No configuration claims $resolved"
    exit 1
  fi

  printf '%s\n' "$ranked"
}

########################################################
# pickers: everything whose job is to name a directory #
########################################################
pickers() {
  # The picker names `tsm create-or-switch` takes: the four built in, then
  # every tsm-* program on PATH.
  printf '%s\n' dir git worktree bookmark
  external_commands
}

run_picker() {
  # Set PICKED_DIR to the directory a picker names. Returns non-zero when
  # nothing was picked and there is nothing left to do.
  #
  # Naming a directory is a picker's whole job: it takes none of the session
  # flags, decides nothing about the session, and answers with one path. The
  # four built in are shell functions; any other name is looked for on PATH
  # as tsm-<name>, which is what makes a picker of your own an ordinary
  # program -- it prints a directory on stdout and says the rest on stderr.
  #
  # Args:
  #   $1: picker: dir, git, worktree, bookmark, or an external picker's name
  #   $@: the picker's own arguments, whatever it makes of them
  local picker="$1"
  shift

  PICKED_DIR=""

  case "$picker" in
    dir | git | worktree | bookmark)
      # A built-in picker names one thing, so a second argument is a typo.
      # Dropping it silently would start a session somewhere that was not
      # asked for; what an external picker makes of its arguments is its own
      # business.
      if [ $# -gt 1 ]; then
        notify "Error: the '$picker' picker takes at most one argument"
        exit 1
      fi

      # The case above is the whitelist, so this only ever names one of the
      # four pick_* functions below.
      "pick_$picker" "$@"
      ;;
    *)
      local external
      external=$(command -v -- "tsm-$picker" 2>/dev/null)

      if [ -z "$external" ]; then
        notify "Error: No picker '$picker'; tsm-$picker is not on PATH"
        exit 1
      fi

      # Stdout is the answer, so a status is all an external picker has left
      # to fail with; it is passed on rather than turned into a session at
      # nowhere. Printing nothing and succeeding is how it backs out.
      PICKED_DIR=$("$external" "$@") || exit $?

      [ -n "$PICKED_DIR" ]
      ;;
  esac
}

pick_dir() {
  # Any directory: $1 when one was given, otherwise one chosen with fzf from
  # TSM_DIRS_CMD.
  #
  # Args:
  #   $1: path: a directory, or empty to open the picker
  local target="$1"

  if [ -n "$target" ]; then
    PICKED_DIR="$target"
    return 0
  fi

  # The process substitution lets the directory generator be killed once fzf
  # exits, rather than run out to the end of the tree.
  local dirs_cmd="${TSM_DIRS_CMD:-$TSM_DIRS_CMD_DEFAULT}"

  exec 3< <(eval "$dirs_cmd")
  local dirs_pid=$!
  PICKED_DIR=$(fzf --cycle --prompt "Directory > " <&3)
  kill "$dirs_pid" 2>/dev/null
  wait "$dirs_pid" 2>/dev/null
  exec 3<&-

  [ -n "$PICKED_DIR" ]
}

pick_git() {
  # A git repository: $1 when one was given, otherwise one chosen with fzf
  # from TSM_GIT_DIRS_CMD. The argument is a path, as `dir` takes -- the two
  # differ only in what they list.
  #
  # Args:
  #   $1: path: a repository directory, or empty to open the picker
  local target="$1"

  if [ -n "$target" ]; then
    PICKED_DIR="$target"
    return 0
  fi

  local git_dirs_cmd="${TSM_GIT_DIRS_CMD:-$TSM_GIT_DIRS_CMD_DEFAULT}"

  local dirs
  dirs=$(eval "$git_dirs_cmd" | sort)

  if [ -z "$dirs" ]; then
    notify "No git repositories found"
    exit 1
  fi

  PICKED_DIR=$(printf '%s\n' "$dirs" | fzf --cycle --prompt "Repo > ")

  [ -n "$PICKED_DIR" ]
}

pick_worktree() {
  # Set PICKED_DIR to a worktree of the current repository: the one whose
  # directory is named $1, or one chosen with fzf. Returns non-zero when the
  # picker was backed out of.
  #
  # Args:
  #   $1: name: a worktree directory name, or empty to open the picker
  local name="$1"

  local worktree_data
  worktree_data=$(git worktree list --porcelain 2>/dev/null | awk '
    /^worktree / { path = substr($0, 10); branch = "" }
    /^branch / { branch = substr($0, 8); sub("refs/heads/", "", branch) }
    /^bare$/ { path = "" }
    /^$/ { if (path != "") print path "\t" (branch != "" ? branch : "(detached)"); path = ""; branch = "" }
    END { if (path != "") print path "\t" (branch != "" ? branch : "(detached)") }
  ')

  if [ -z "$worktree_data" ]; then
    notify "No worktrees found"
    exit 1
  fi

  if [ -n "$name" ]; then
    PICKED_DIR=$(echo "$worktree_data" | while IFS=$'\t' read -r wt _; do
      if [ "${wt##*/}" = "$name" ]; then
        echo "$wt"
        break
      fi
    done)

    if [ -z "$PICKED_DIR" ]; then
      notify "No worktree found matching '$name'"
      exit 1
    fi

    return 0
  fi

  # Header labels are measured alongside the values so short columns still
  # widen to fit them. fzf indents --header by the two columns its pointer
  # takes, so the header lines up with the rows on its own.
  local name_label='wt' branch_label='branch'
  local fzf_input header max_name=${#name_label} max_branch=${#branch_label}
  while IFS=$'\t' read -r wt branch; do
    local wt_name="${wt##*/}"
    (( ${#wt_name} > max_name )) && max_name=${#wt_name}
    (( ${#branch} > max_branch )) && max_branch=${#branch}
  done <<< "$worktree_data"
  fzf_input=$(echo "$worktree_data" | while IFS=$'\t' read -r wt branch; do
    printf '%s\t%-*s  \033[32m%-*s\033[0m  %s\n' "$wt" "$max_name" "${wt##*/}" "$max_branch" "$branch" "$wt"
  done)
  header=$(printf '%-*s  %-*s  %s' "$max_name" "$name_label" "$max_branch" "$branch_label" 'path')

  local selected
  selected=$(echo "$fzf_input" | fzf --ansi --cycle --with-nth=2 --delimiter=$'\t' --prompt "Worktree > " --header "$header")

  PICKED_DIR="${selected%%	*}"

  [ -n "$PICKED_DIR" ]
}

pick_bookmark() {
  # The directory a bookmark points at: the one keyed to $1 when a character
  # was given, otherwise one chosen with fzf. Like every other picker, the
  # argument is only there to skip the fzf.
  #
  # Args:
  #   $1: char: a bookmark character, or empty to open the picker
  local char="$1"

  if [ -n "$char" ]; then
    check_bookmark_char "$char"

    if ! PICKED_DIR=$(bookmark_directory "$char"); then
      notify "Error: No bookmark '$char'"
      exit 1
    fi

    return 0
  fi

  local entries
  entries=$(bookmark_entries)

  if [ -z "$entries" ]; then
    notify "No bookmarks set"
    exit 1
  fi

  # ctrl-x removes the bookmark under the cursor, then rebuilds the list from
  # disk. fzf hands a binding to a shell, so tsm's path is quoted for one;
  # fzf itself quotes {1}.
  local self
  printf -v self '%q' "$(tsm_self)"

  local selected
  selected=$(printf '%s\n' "$entries" | fzf \
    --cycle \
    --delimiter=$'\t' \
    --with-nth=3 \
    --prompt "Bookmark > " \
    --header $':: \e[33mctrl-x\e[0m to \e[31mremove\e[0m' \
    --bind "ctrl-x:execute-silent($self bookmark-remove {1})+reload($self _bookmark-entries)")

  [ -n "$selected" ] || return 1

  # The row carries the directory in its second field, so the session is
  # rooted at the bookmarked path rather than the ~ the row displayed.
  local row="${selected#*$'\t'}"
  PICKED_DIR="${row%%$'\t'*}"
}

###################################################
# the session: the one thing every picker ends in #
###################################################

session_at() {
  # Switch to the session already open at a directory, or create one there.
  #
  # Args:
  #   $1: path: the directory a picker named
  #   $@: --no-config, --prompt-name
  local selected="$1"
  shift

  local no_config="" prompt_name="" arg
  for arg in "$@"; do
    case "$arg" in
      --no-config) no_config=1 ;;
      --prompt-name) prompt_name=1 ;;
    esac
  done

  selected="${selected/#\~/$HOME}"

  # Resolved here rather than in the pickers: a session is identified by the
  # directory it was started at, so every path has to arrive in the same
  # form no matter who printed it.
  local resolved
  if ! resolved=$(cd "$selected" 2>/dev/null && pwd -P); then
    notify "Error: Directory '$selected' does not exist"
    exit 1
  fi
  selected="$resolved"

  # A session is identified by the directory it was started at, not by its
  # name: picking a directory that already has a session returns to it,
  # whatever it has been renamed to. Nothing is being created, so this is
  # also the answer -p gets.
  local existing
  if existing=$(session_for_path "$selected"); then
    switch_or_attach "$existing"
    exit 0
  fi

  # A configuration may claim the path with `pattern`, naming the session
  # (`name`) and building it (`start`). -c opts out of both.
  local matching_file="" matching_config=""
  if [ -z "$no_config" ]; then
    if matching_file=$(matching_config_for_root "$selected"); then
      matching_config=$(config_name_for_file "$matching_file")
    else
      matching_file=""
    fi
  fi

  # The configuration's name if it has an opinion, the directory's otherwise.
  local session_name=""
  [ -n "$matching_file" ] && session_name=$(config_session_name "$matching_file" "$selected")
  [ -n "$session_name" ] || session_name=$(default_session_name "$selected")

  if [ -n "$prompt_name" ]; then
    # -p is the last word: the rules still make the suggestion, but anything
    # typed over it wins. session_name_prompt returns rather than exits
    # because an exit inside a command substitution only ends the subshell.
    session_name=$(session_name_prompt "$selected" "$session_name") || exit 1
  else
    # The path is not open (settled above), so a session already holding this
    # name is a genuine collision: two directories whose names landed on the
    # same string. Switching there would go somewhere that was not picked, so
    # report it and ask for a name.
    if tmux has-session -t "=$session_name" 2>/dev/null; then
      local taken="$session_name" existing_path
      existing_path=$(path_for_session "$taken")
      report_name_collision "$taken" "$selected" "$existing_path"

      # quiet: the report already put the path on stderr.
      session_name=$(session_name_prompt "$selected" "$taken" quiet) || {
        # The prompt's error goes to stderr, which has nowhere to land under
        # tmux's run-shell; notify becomes a tmux message there.
        notify "Error: session '$taken' is already open at ${existing_path:-an unknown path}; $selected needs a name of its own"
        exit 1
      }
    fi
  fi

  local width height
  read -r width height < <(client_size)

  # Sized up front: tmux creates detached sessions at 80x24, and percentage
  # splits made before the client attaches drift once the real size arrives.
  tmux new-session -d -s "$session_name" -c "$selected" ${width:+-x "$width"} ${height:+-y "$height"} || exit 1

  # Record the directory on the session itself; this is what identifies it.
  # The trailing `:` is load-bearing: set-option takes a target pane, and
  # `=name` alone is read as a pane target and fails to resolve, while
  # `=name:` is that session's current pane.
  tmux set-option -t "=$session_name:" @tsm_path "$selected"

  if [ -n "$matching_file" ]; then
    # A session no configuration claimed runs no script, so it gets no log.
    local log_dir="$LOG_DIR/$session_name"
    local log_file="$log_dir/tsm.log"
    mkdir -p "$log_dir"
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Starting session '$session_name'" > "$log_file"

    # Subshell so a configuration aborting under its own `set -e` does not
    # tear down a session tmux already created. The marker is recorded inside
    # it: it is only true once the configuration has actually been applied,
    # and kill_session reads it to know which file owns the cleanup.
    (
      export SESSION="$session_name" ROOT="$selected"
      run_config "$matching_file" start
      tmux set-environment -t "=$session_name" TSM_MATCHING_CONFIG "$matching_config"
    ) >> "$log_file" 2>&1
  fi

  switch_or_attach "$session_name"
}

create_or_switch() {
  # Start a session at the directory a picker names, or switch to the session
  # already open there:
  #
  #   tsm create-or-switch <picker> [-c] [-p] [picker args]
  #
  # The only place a session is made. The flags are parsed here because they
  # are about the session rather than about the picking, so they mean the
  # same thing behind every picker, one you wrote included.
  local picker="$1"
  shift

  # The picker comes first, before the flags: it says what the flags are
  # being applied to, and a flag in its place is the easy way to get that
  # backwards.
  case "$picker" in
    '' | -*)
      notify "Error: 'tsm create-or-switch' takes a picker first: $(pickers | tr '\n' ' ')"
      exit 1
      ;;
  esac

  local session_flags=() picker_args=() arg
  expand_short_flags "$@"
  for arg in "${EXPANDED_ARGS[@]}"; do
    case "$arg" in
      -c | --no-config) session_flags+=(--no-config) ;;
      -p | --prompt-name) session_flags+=(--prompt-name) ;;
      -*)
        notify "Error: Unknown option '$arg' for 'tsm create-or-switch'"
        exit 1
        ;;
      *) picker_args+=("$arg") ;;
    esac
  done

  run_picker "$picker" ${picker_args+"${picker_args[@]}"} || exit 0

  session_at "$PICKED_DIR" ${session_flags+"${session_flags[@]}"}
}

bookmark_add() {
  # Bookmark a directory at a character, replacing whatever that character
  # was bookmarking before -- the way setting a vim mark that is set does.
  #
  # Args:
  #   $1: char: the bookmark character
  #   $2: path: directory to bookmark (default: the current directory)
  local char="$1" path="${2:-$PWD}"

  path="${path/#\~/$HOME}"

  if [ ! -d "$path" ]; then
    notify "Error: Directory '$path' does not exist"
    exit 1
  fi

  path=$(cd "$path" && pwd -P)

  if [ -z "$path" ]; then
    notify "Error: Directory '${2:-$PWD}' could not be resolved"
    exit 1
  fi

  # Rejected rather than escaped: a control character would have to survive
  # JSON, whole-line reads, and the picker, and no directory worth
  # bookmarking has one.
  case "$path" in
    *[[:cntrl:]]*)
      notify "Error: '$path' cannot be bookmarked: its path contains a control character"
      exit 1
      ;;
  esac

  # tsm does not ask for the character itself: inside tmux a key binding
  # asks with command-prompt -1 and passes the answer in (see the README),
  # which is the only way it was ever reached.
  if [ -z "$char" ]; then
    notify "Error: 'tsm bookmark-add' needs a character to bookmark ${path/#"$HOME"/\~} at"
    exit 1
  fi

  check_bookmark_char "$char"

  {
    read_bookmarks | without_bookmark "$char"
    printf '%s\t%s\n' "$char" "$path"
  } | LC_ALL=C sort | write_bookmarks

  # What the status line shows just changed, and no session was created or
  # killed for a hook to notice it.
  refresh_status

  notify "Bookmark set: $char -> $path"
}

bookmark_remove() {
  # Remove a bookmark.
  #
  # Args:
  #   $1: char: the bookmark character to remove
  local char="$1"

  if [ -z "$char" ]; then
    notify "Error: 'tsm bookmark-remove' needs a character"
    exit 1
  fi

  check_bookmark_char "$char"

  if ! bookmark_directory "$char" > /dev/null; then
    notify "Error: No bookmark '$char'"
    exit 1
  fi

  read_bookmarks | without_bookmark "$char" | write_bookmarks

  refresh_status

  notify "Bookmark removed: $char"
}

bookmark_status() {
  # Print the bookmark characters of the open sessions for a tmux status
  # line, the current session's styled differently. Only bookmarks with a
  # session open are shown, so the line stays short. Nothing is notified:
  # this runs on every status line redraw.
  #
  # Args:
  #   $1: path: the directory of the session to treat as the current one
  #       (default: the session tmux reports as current)
  #   -s, --style: tmux style for the other sessions' characters
  #   -c, --current-style: tmux style for the current session's character
  local style="dim" current_style="fg=yellow,bold" current="" current_given=""

  # Styles are given without their #[] wrapper, so a status line format
  # holding one does not have to escape it.
  while [ $# -gt 0 ]; do
    case "$1" in
      -s | --style | -c | --current-style)
        if [ $# -lt 2 ]; then
          notify "Error: '$1' needs a tmux style"
          exit 1
        fi
        case "$1" in
          -s | --style) style="$2" ;;
          -c | --current-style) current_style="$2" ;;
        esac
        shift 2
        ;;
      -*)
        notify "Error: Unknown option '$1' for 'tsm bookmark-status'"
        exit 1
        ;;
      *)
        if [ -n "$current_given" ]; then
          notify "Error: Too many arguments for 'tsm bookmark-status'"
          exit 1
        fi
        current="$1"
        current_given=1
        shift
        ;;
    esac
  done

  local open
  open=$(tmux list-sessions -F '#{session_path}' 2>/dev/null)
  [ -n "$open" ] || return 0

  # Which session is current must be given by whoever draws the status line:
  # tmux runs a #() command without a client and shares its output between
  # them all, so asking here would answer the same for every client. A status
  # line passes #{session_path}, expanded per client. Asking is the fallback
  # for a shell with a session of its own.
  if [ -z "$current_given" ] && [ -n "$TMUX" ]; then
    current=$(tmux display-message -p '#{session_path}' 2>/dev/null)
  fi

  # Each character is padded inside its own style, so a style with a
  # background reads as a block. Each style is preceded by a reset, because
  # tmux styles accumulate.
  read_bookmarks | TSM_OPEN_PATHS="$open" TSM_CURRENT_PATH="$current" \
    TSM_STYLE="$style" TSM_CURRENT_STYLE="$current_style" awk -F'\t' '
      BEGIN {
        n = split(ENVIRON["TSM_OPEN_PATHS"], paths, "\n")
        for (i = 1; i <= n; i++) if (paths[i] != "") open[paths[i]]
        current = ENVIRON["TSM_CURRENT_PATH"]
        style = ENVIRON["TSM_STYLE"]
        current_style = ENVIRON["TSM_CURRENT_STYLE"]
      }

      $2 in open {
        out = out "#[default]#[" (current != "" && $2 == current ? current_style : style) "] " $1 " "
      }

      END { if (out != "") print out "#[default]" }
    '
}

browse_logs() {
  local session="$1"

  local search_dir
  if [ -n "$session" ]; then
    search_dir="$LOG_DIR/$session"
    if [ ! -d "$search_dir" ]; then
      notify "Error: No log directory found for session '$session'"
      exit 1
    fi
  else
    search_dir="$LOG_DIR"
  fi

  local log_files
  log_files=$(find "$search_dir" -type f -name '*.log' 2>/dev/null | sed "s|^$LOG_DIR/||" | sort)

  if [ -z "$log_files" ]; then
    notify "No log files found"
    exit 1
  fi

  local selected
  selected=$(echo "$log_files" | fzf \
    --cycle \
    --bind=ctrl-d:preview-half-page-down \
    --bind=ctrl-u:preview-half-page-up \
    --bind="ctrl-o:execute(${EDITOR:-vi} '$LOG_DIR/{}')" \
    --prompt "Logs > " \
    --header $':: \e[33mEnter\e[0m to \e[31mtail\e[0m | \e[33mctrl-o\e[0m to \e[31mopen in editor\e[0m | \e[33mctrl-d\e[0m to \e[31mpreview page down\e[0m | \e[33mctrl-u\e[0m to \e[31mpreview page up\e[0m' \
    --preview "tail -n 100000 -f '$LOG_DIR/{}'" \
    --preview-window follow)

  if [ -z "$selected" ]; then
    exit 0
  fi

  tail -n 1000 -f "$LOG_DIR/$selected"
}

# Parse arguments
if [ $# -eq 0 ]; then
  usage
  exit 0
fi

command="$1"
shift

case "$command" in
  active)
    active_session "$1"
    ;;
  last)
    last_session
    ;;
  kill)
    kill_session "$1"
    ;;
  create-or-switch)
    create_or_switch "$@"
    ;;
  bookmark-add)
    bookmark_add "$1" "$2"
    ;;
  bookmark-remove)
    bookmark_remove "$1"
    ;;
  bookmark-status)
    bookmark_status "$@"
    ;;
  match)
    match_configs "$1"
    ;;
  logs)
    browse_logs "$1"
    ;;
  _record-switch)
    # Internal: invoked by the client-session-changed hook (see README).
    record_switch "$1" "$2"
    ;;
  _refresh-status)
    # Internal: invoked by the session-created/session-closed hooks (see
    # README).
    refresh_status
    ;;
  _bookmark-entries)
    # Internal: rebuilds the bookmark picker's rows for its reload binding.
    bookmark_entries
    ;;
  _external-commands)
    # Internal: the tsm-* programs on PATH, for the shell completions.
    external_commands
    ;;
  _pickers)
    # Internal: the picker names create-or-switch takes, for the shell
    # completions.
    pickers
    ;;
  help)
    usage
    ;;
  *)
    # Not a built-in: look for it on PATH as `tsm-<command>`, the way git
    # finds its own external commands. Running a picker this way prints the
    # directory it names and stops there; `tsm create-or-switch <name>` is
    # what turns that into a session.
    external=$(command -v -- "tsm-$command" 2>/dev/null)
    if [ -n "$external" ]; then
      TSM=$(tsm_self)
      export TSM
      exec "$external" "$@"
    fi

    notify "Error: Unknown command '$command'"
    usage
    exit 1
    ;;
esac
